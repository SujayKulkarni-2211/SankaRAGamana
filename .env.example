# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Groq — three keys rotated round-robin across agents
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Groq models (optional — override when Groq deprecates a model).
#   HEAVY: agents, reflection, synthesis, translation (reasoning-grade)
#   LIGHT: seeker profiler + memory distillation (fast/cheap)
# Defaults track Groq's current recommendations.
GROQ_MODEL_HEAVY=openai/gpt-oss-120b
GROQ_MODEL_LIGHT=llama-3.1-8b-instant

# Admin Auth
ADMIN_USERNAME=
ADMIN_PASSWORD=
JWT_SECRET=

# Model device: 'cpu' or 'cuda'
DEVICE=cpu
