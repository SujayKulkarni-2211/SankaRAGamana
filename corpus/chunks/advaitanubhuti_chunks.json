[
  {
    "chunk_id": "advaitanubhuti_001",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अहमानन्दसत्यादिलक्षणः केवलः शिवः ।\nसदानन्दादिरूपं यत्तेनाहमचलोऽद्वयः",
    "verse_number": "1",
    "char_count": 68
  },
  {
    "chunk_id": "advaitanubhuti_002",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अक्षिदोषाद्यथैकोऽपि द्वयवद्भाति चन्द्रमाः ।\nएकोऽप्यात्मा तथा भाति द्वयवन्मायया मृषा",
    "verse_number": "2",
    "char_count": 83
  },
  {
    "chunk_id": "advaitanubhuti_003",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अक्षिदोषविहीनानामेक एव यथा शशी ।\nमायादोषविहीनानामात्मैवैकस्तथा सदा",
    "verse_number": "3",
    "char_count": 66
  },
  {
    "chunk_id": "advaitanubhuti_004",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "द्वित्वं भात्यक्षिदोषेण चन्द्रे स्वे मायया जगत् ।\nद्वित्वं मृषा यथा चन्द्रे मृषा द्वैतं तथात्मनि",
    "verse_number": "4",
    "char_count": 96
  },
  {
    "chunk_id": "advaitanubhuti_005",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "आत्मनः कार्यमाकाशो विनात्मानं न संभवेत् ।\nकार्यस्य पूर्णता सिद्धा किं पुनः पूर्णतात्मनः",
    "verse_number": "5",
    "char_count": 87
  },
  {
    "chunk_id": "advaitanubhuti_006",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कार्यभूतो यथाकाश एक एव न हि द्विधा ।\nहेतुभूतस्तथात्मायमेक एव विजानतः",
    "verse_number": "6",
    "char_count": 68
  },
  {
    "chunk_id": "advaitanubhuti_007",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "एकोऽपि द्वयवद्भाति यथाकाश उपाधितः ।\nएकोऽपि द्वयवत्पूर्णस्तथात्मायमुपाधितः",
    "verse_number": "7",
    "char_count": 73
  },
  {
    "chunk_id": "advaitanubhuti_008",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कारणोपाधिचैतन्यं कार्यसंस्थाच्चितोऽधिकम् ।\nन घटाभ्रान्मृदाकाशः कुत्रचिन्नाधिको भवेत्",
    "verse_number": "8",
    "char_count": 84
  },
  {
    "chunk_id": "advaitanubhuti_009",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "निर्गतोपाधिराकाश एक एव यथा भवेत् ।\nएक एव तथात्मायं निर्गतोपाधिकः सदा",
    "verse_number": "9",
    "char_count": 68
  },
  {
    "chunk_id": "advaitanubhuti_010",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "आकाशादन्य आकाश आकाशस्य यथा न हि ।\nएकत्वादात्मनो नान्य आत्मा सिध्यति चात्मनः",
    "verse_number": "10",
    "char_count": 75
  },
  {
    "chunk_id": "advaitanubhuti_011",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "मेघयोगाद्यथा नीरं करकाकारतामियात् ।\nमायायोगात्तथैवात्मा प्रपञ्चाकारतामियात्",
    "verse_number": "11",
    "char_count": 75
  },
  {
    "chunk_id": "advaitanubhuti_012",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "वर्षोपल इवाभाति नीरमेवाभ्रयोगतः ।\nवर्षोपलविनाशेन नीरनाशो यथा न हि",
    "verse_number": "12",
    "char_count": 65
  },
  {
    "chunk_id": "advaitanubhuti_013",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "आत्मैवायं तथा भाति मायायोगात्प्रपञ्चवत् ।\nप्रपञ्चस्य विनाशेन स्वात्मनाशो न हि क्वचित्",
    "verse_number": "13",
    "char_count": 85
  },
  {
    "chunk_id": "advaitanubhuti_014",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "जलादन्य इवाभाति जलोत्थो बुद्बुदो यथा ।\nतथात्मनः पृथगिव प्रपञ्चोऽयमनेकधा",
    "verse_number": "14",
    "char_count": 71
  },
  {
    "chunk_id": "advaitanubhuti_015",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "यथा बुद्बुदनाशेन जलनाशो न कर्हिचित् ।\nतथा प्रपञ्चनाशेन नाशः स्यादात्मनो न हि",
    "verse_number": "15",
    "char_count": 76
  },
  {
    "chunk_id": "advaitanubhuti_016",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अहिनिर्ल्वयनीजातः शुच्यादिर्नाहिमाप्नुयात् ।\nतथा स्थूलादिसंभूतः शुच्यादिर्नाप्नुयादिमम्",
    "verse_number": "16",
    "char_count": 87
  },
  {
    "chunk_id": "advaitanubhuti_017",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "त्यक्तां त्वचमहिर्यद्वदात्मत्वेन न मन्यते ।\nआत्मत्वेन सदा ज्ञानी त्यक्तदेहत्रयं तथा",
    "verse_number": "17",
    "char_count": 83
  },
  {
    "chunk_id": "advaitanubhuti_018",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अहिनिर्ल्वयनीनाशादहेर्नाशो यथा न हि ।\nदेहत्रयविनाशेन नात्मनाशस्तथा भवेत्",
    "verse_number": "18",
    "char_count": 72
  },
  {
    "chunk_id": "advaitanubhuti_019",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तक्रादिलवणोपेतमज्ञैर्लवणवद्यथा ।\nआत्मा स्थूलादिसंयुक्तो दूष्यते स्थूलकादिवत्",
    "verse_number": "19",
    "char_count": 76
  },
  {
    "chunk_id": "advaitanubhuti_020",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अयःकाष्ठादिकं यद्वद्वह्निवद्वह्नियोगतः ।\nभाति स्थूलादिकं सर्वमात्मवत्स्वात्मयोगतः",
    "verse_number": "20",
    "char_count": 81
  },
  {
    "chunk_id": "advaitanubhuti_021",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "दाहको नैव दाह्यं स्याद्दाह्यं तद्वन्न दाहकः ।\nनैवात्मायमनात्मा स्यादनात्मायं न चात्मकः",
    "verse_number": "21",
    "char_count": 86
  },
  {
    "chunk_id": "advaitanubhuti_022",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "प्रमेयादित्रयं सार्थं भानुना घटकुड्यवत् ।\nयेन भाति स एवाहं प्रमेयादिविलक्षणः",
    "verse_number": "22",
    "char_count": 76
  },
  {
    "chunk_id": "advaitanubhuti_023",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "भानुस्फुरणतो यद्वत्स्फुरतीव घटादिकम् ।\nस्फुरतीव प्रमेयादिरात्मस्फुरणतस्तथा",
    "verse_number": "23",
    "char_count": 74
  },
  {
    "chunk_id": "advaitanubhuti_024",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "पिष्टादिगुलसम्पर्काद्गुलवत्प्रीतिमान्यथा ।\nआत्मयोगात्प्रमेयादिरात्मवत्प्रीतिमान्भवेत्",
    "verse_number": "24",
    "char_count": 85
  },
  {
    "chunk_id": "advaitanubhuti_025",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "घटनीरान्नपिष्टानामुष्णत्वं वह्नियोगतः ।\nवह्निं विना कथं तेषामुष्णता स्याद्यथा क्वचित्",
    "verse_number": "25",
    "char_count": 85
  },
  {
    "chunk_id": "advaitanubhuti_026",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "भूतभौतिकदेहानां स्फूर्तिता स्वात्मयोगतः ।\nविनात्मानं कथं तेषां स्फूर्तिता स्यात्तथा क्वचित्",
    "verse_number": "26",
    "char_count": 91
  },
  {
    "chunk_id": "advaitanubhuti_027",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "नानाविधेषु कुम्भेषु वसत्येकं नभो यथा ।\nनानाविधेषु देहेषु तद्वदेको वसाम्यहम्",
    "verse_number": "27",
    "char_count": 75
  },
  {
    "chunk_id": "advaitanubhuti_028",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "नानाविधत्वं कुम्भानां न यात्येव यथा नभः ।\nनानाविधत्वं देहानां तद्वदेव न याम्यहम्",
    "verse_number": "28",
    "char_count": 80
  },
  {
    "chunk_id": "advaitanubhuti_029",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "(नयाम्यहम्)\n\nयथा घटेषु नष्टेषु घटाकाशो न नश्यति ।\nतथा देहेषु नष्टेषु नैव नश्यामि सर्वगः",
    "verse_number": "29",
    "char_count": 87
  },
  {
    "chunk_id": "advaitanubhuti_030",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "उत्तमादीनि पुष्पाणि वर्तन्ते सूत्रके यथा ।\nउत्तमाद्यास्तथा देहा वर्तन्ते मयि सर्वदा",
    "verse_number": "30",
    "char_count": 83
  },
  {
    "chunk_id": "advaitanubhuti_031",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "यथा न संस्पृशेत्सूत्रं पुष्पाणामुत्तमादिता ।\nतथा नैकं सर्वगं मां देहानामुत्तमादिता",
    "verse_number": "31",
    "char_count": 82
  },
  {
    "chunk_id": "advaitanubhuti_032",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "पुष्पेषु तेषु नष्टेषु यद्वत्सूत्रं न नश्यति ।\nतथा देहेषु नष्टेषु नैव नश्याम्यहं सदा",
    "verse_number": "32",
    "char_count": 83
  },
  {
    "chunk_id": "advaitanubhuti_033",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "पर्यङकरज्जुरन्ध्रेषु नानेवैकापि सूर्यभा ।\nएकोऽप्यनेकवद्भाति तथा क्षेत्रेषु सर्वगः",
    "verse_number": "33",
    "char_count": 81
  },
  {
    "chunk_id": "advaitanubhuti_034",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "रज्जुरन्ध्रस्थदोषादि सूर्यभां न स्पृशेद्यथा ।\nतथा क्षेत्रस्थदोषादि सर्वगं मां न संस्पृशेत्",
    "verse_number": "34",
    "char_count": 90
  },
  {
    "chunk_id": "advaitanubhuti_035",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तद्रज्जुरन्ध्रनाशेषु नैव नश्यति सूर्यभा ।\nतथा क्षेत्रविनाशेषु नैव नश्यामि सर्वगः",
    "verse_number": "35",
    "char_count": 80
  },
  {
    "chunk_id": "advaitanubhuti_036",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "देहो नाहं प्रदृश्यत्वाद्भौतिकत्वान्न चेन्द्रियम् ।\nप्राणो नाहमनेकत्वान्मनो नाहं चलत्वतः",
    "verse_number": "36",
    "char_count": 87
  },
  {
    "chunk_id": "advaitanubhuti_037",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "बुद्धिर्नाहं विकारित्वात्तमो नाहं जडत्वतः ।\nदेहेन्द्रियादिकं नाहं विनाशित्वाद्घटादिवत्",
    "verse_number": "37",
    "char_count": 86
  },
  {
    "chunk_id": "advaitanubhuti_038",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "देहेन्द्रियप्राणमनोबुद्ध्यज्ञानानि भासयन् ।\nअहंकारं तथा भामि चैतेषामभिमानिनम्",
    "verse_number": "38",
    "char_count": 77
  },
  {
    "chunk_id": "advaitanubhuti_039",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सर्वं जगदिदं नाहं विषयत्वादिदंधियः ।\nअहं नाहं सुषुप्त्यादौ अहमः साक्षितः सदा",
    "verse_number": "39",
    "char_count": 76
  },
  {
    "chunk_id": "advaitanubhuti_040",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सुप्तौ यथा निर्विकारस्तथावस्थाद्वयेऽपि च ।\nद्वयोर्मात्राभियोगेन विकारीव विभाम्यहम्",
    "verse_number": "40",
    "char_count": 82
  },
  {
    "chunk_id": "advaitanubhuti_041",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "उपाधिनीलरक्ताद्यैः स्फटिको नैव लिप्यते ।\nतथात्मा कोशजैः सर्वैः कामाद्यैर्नैव लिप्यते",
    "verse_number": "41",
    "char_count": 84
  },
  {
    "chunk_id": "advaitanubhuti_042",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "फालेन भ्राम्यमाणेन भ्रमतीव यथा मही ।\nअगोऽप्यात्मा विमूढेन चलतीव प्रदृश्यते",
    "verse_number": "42",
    "char_count": 74
  },
  {
    "chunk_id": "advaitanubhuti_043",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "देहत्रयमिदं नित्यमात्मत्वेनाभिमन्यते ।\nयावत्तावदयं मूढो नानायोनिषु जायते",
    "verse_number": "43",
    "char_count": 72
  },
  {
    "chunk_id": "advaitanubhuti_044",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "निद्रादेहजदुःखादि जाग्रद्देहं न संस्पृशेत् ।\nजाग्रद्देहजदुःखादिस्तथात्मानं न संस्पृशेत्",
    "verse_number": "44",
    "char_count": 87
  },
  {
    "chunk_id": "advaitanubhuti_045",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "जाग्रद्देहवदाभाति निद्रादेहस्तु निद्रया ।\nनिद्रादेहविनाशेन जाग्रद्देहो न नश्यति",
    "verse_number": "45",
    "char_count": 79
  },
  {
    "chunk_id": "advaitanubhuti_046",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तथायमात्मवद्भाति जाग्रद्देहस्तु जागरात् ।\nजाग्रद्देहविनाशेन नात्मा नश्यति कर्हिचित्",
    "verse_number": "46",
    "char_count": 83
  },
  {
    "chunk_id": "advaitanubhuti_047",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "हित्वायं स्वाप्निकं देहं जाग्रद्देहमपेक्षते ।\nजाग्रद्देहप्रबुद्धोऽयं हित्वात्मानं यथा तथा",
    "verse_number": "47",
    "char_count": 89
  },
  {
    "chunk_id": "advaitanubhuti_048",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "स्वप्नभोगे यथैवेच्छा प्रबुद्धस्य न विद्यते ।\nअसत्स्वर्गादिके भोगे नैवेच्छा ज्ञानिनस्तथा",
    "verse_number": "48",
    "char_count": 87
  },
  {
    "chunk_id": "advaitanubhuti_049",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "भोक्त्रा बहिर्यथा भोग्यः सर्पो दृषदि कल्पितः ।\nरूपशीलादयश्चात्मभोगा भोग्यस्वरूपकाः",
    "verse_number": "49",
    "char_count": 82
  },
  {
    "chunk_id": "advaitanubhuti_050",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "ज्ञस्य नास्त्येव संसारो यद्वदज्ञस्य कर्मिणः ।\nजानतो नैव भीर्यद्वद्रज्जुसर्पमजानतः",
    "verse_number": "50",
    "char_count": 81
  },
  {
    "chunk_id": "advaitanubhuti_051",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सैन्धवस्य घनो यद्वज्जलयोगाज्जलं भवेत् ।\nस्वात्मयोगात्तथा बुद्धिरात्मैव ब्रह्मवेदिनः",
    "verse_number": "51",
    "char_count": 83
  },
  {
    "chunk_id": "advaitanubhuti_052",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तोयाश्रयेषु सर्वेषु भानुरेकोऽप्यनेकवत् ।\nएकोऽप्यात्मा तथा भाति सर्वक्षेत्रेष्वनेकवत्",
    "verse_number": "52",
    "char_count": 84
  },
  {
    "chunk_id": "advaitanubhuti_053",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "भानोरन्य इवाभाति जलभानुर्जले यथा ।\nआत्मनोऽन्य इवाभासो भाति बुद्धौ तथात्मनः",
    "verse_number": "53",
    "char_count": 74
  },
  {
    "chunk_id": "advaitanubhuti_054",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "बिम्बं विना यथा नीरे प्रतिबिम्बो भवेत्कथम् ।\nविनात्मानं तथा बुद्धौ चिदाभासो भवेत्कथम्",
    "verse_number": "54",
    "char_count": 85
  },
  {
    "chunk_id": "advaitanubhuti_055",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "प्रतिबिम्बचलत्वाद्या यथा बिम्बस्य कर्हिचित् ।\nन भवेयुस्तथाऽऽभासकर्तृत्वाद्यास्तु नात्मनः",
    "verse_number": "55",
    "char_count": 88
  },
  {
    "chunk_id": "advaitanubhuti_056",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "(भवेयुस्तथाभास)\n\nजले शैत्यादिकं यद्वज्जलभानुं न संस्पृशेत् ।\nबुद्धेः कर्मादिकं तद्वच्चिदाभासं न संस्पृशेत्",
    "verse_number": "56",
    "char_count": 106
  },
  {
    "chunk_id": "advaitanubhuti_057",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "बुद्धेः कर्तृत्वभोक्तृत्वदुःखित्वाद्यैस्तु संयुतः ।\nचिदाभासो विकारीव शरावस्थाम्बुभानुवत्",
    "verse_number": "57",
    "char_count": 88
  },
  {
    "chunk_id": "advaitanubhuti_058",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "शरावस्थोदके नष्टे तत्स्थो भानुर्विनष्टवत् ।\nबुद्धेर्लये तथा सुप्तौ नष्टवत्प्रतिभात्ययम्",
    "verse_number": "58",
    "char_count": 87
  },
  {
    "chunk_id": "advaitanubhuti_059",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "जलस्थार्कं जलं चोर्मिं भासयन्भाति भास्करः ।\nआत्माभासं धियं बुद्धेः कर्तृत्वादीनयं तथा",
    "verse_number": "59",
    "char_count": 85
  },
  {
    "chunk_id": "advaitanubhuti_060",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "मेघावभासको भानुर्मेघच्छन्नोऽवभासते ।\nमोहावभासकस्तद्वन्मोहच्छन्नो विभात्ययम्",
    "verse_number": "60",
    "char_count": 75
  },
  {
    "chunk_id": "advaitanubhuti_061",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "भास्यं मेघादिकं भानुर्भासयन्प्रतिभासते ।\nतथा स्थूलादिकं भास्यं भासयन्प्रतिभात्ययम्",
    "verse_number": "61",
    "char_count": 82
  },
  {
    "chunk_id": "advaitanubhuti_062",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सर्वप्रकाशको भानुः प्रकाश्येर्नैव दूष्यते । (प्रकाश्यैर्नैव)\nसर्वप्रकाशको ह्यात्मा सर्वैस्तद्वन्न दूष्यते",
    "verse_number": "62",
    "char_count": 105
  },
  {
    "chunk_id": "advaitanubhuti_063",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "मुकुरस्थं मुखं यद्वन्मुखवत्प्रथते मृषा ।\nबुद्धिस्थाभासकस्तद्वदात्मवत्प्रथते मृषा",
    "verse_number": "63",
    "char_count": 80
  },
  {
    "chunk_id": "advaitanubhuti_064",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "मुकुरस्थस्य नाशेन मुखनाशो भवेत्कथम् ।\nबुद्धिस्थाभासनाशेन नाशो नैवात्मनः क्वचित्",
    "verse_number": "64",
    "char_count": 79
  },
  {
    "chunk_id": "advaitanubhuti_065",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "ताम्रकल्पितदेवादिस्ताम्रादन्य इव स्फुरेत् ।\nप्रतिभास्यादिरूपेण तथात्मोत्थमिदं जगत्",
    "verse_number": "65",
    "char_count": 82
  },
  {
    "chunk_id": "advaitanubhuti_066",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "ईशजीवात्मवद्भाति यथैकमपि ताम्रकम् ।\nएकोऽप्यात्मा तथैवायमीशजीवादिवन्मृषा",
    "verse_number": "66",
    "char_count": 71
  },
  {
    "chunk_id": "advaitanubhuti_067",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "यथेश्वरादिनाशेन ताम्रनाशो न विद्यते ।\nतथेश्वरादिनाशेन नाशो नैवात्मनः सदा",
    "verse_number": "67",
    "char_count": 72
  },
  {
    "chunk_id": "advaitanubhuti_068",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अध्यस्तो रज्जुसर्पोऽयं सत्यवद्रज्जुसत्तया ।\nतथा जगदिदं भाति सत्यवत्स्वात्मसत्तया",
    "verse_number": "68",
    "char_count": 80
  },
  {
    "chunk_id": "advaitanubhuti_069",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अध्यस्ताहेरभावेन रज्जुरेवावशिष्यते ।\nतथा जगदभावेन सदात्मैवावशिष्यते",
    "verse_number": "69",
    "char_count": 67
  },
  {
    "chunk_id": "advaitanubhuti_070",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "स्फटिके रक्तता यद्वदुपाधेर्नीलताम्बरे ।\nयथा जगदिदं भाति तथा सत्यमिवाद्वये",
    "verse_number": "70",
    "char_count": 73
  },
  {
    "chunk_id": "advaitanubhuti_071",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "स्फटिके रक्तता मिथ्या मृषा खे नीलता यथा ।\nतथा जगदिदं मिथ्या एकस्मिन्नद्वये मयि",
    "verse_number": "71",
    "char_count": 78
  },
  {
    "chunk_id": "advaitanubhuti_072",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "जीवेश्वरादिभावेन भेदं पश्यति मूढधीः ।\nनिर्भेदे निर्विशेषेऽस्मिन्कथं भेदो भवेद्ध्रुवम्",
    "verse_number": "72",
    "char_count": 85
  },
  {
    "chunk_id": "advaitanubhuti_073",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "लिङ्गस्य धारणादेव शिवोऽयं जीवतां व्रजेत् ।\nलिङ्गनाशे शिवस्यास्य जीवतावेशता कुतः",
    "verse_number": "73",
    "char_count": 79
  },
  {
    "chunk_id": "advaitanubhuti_074",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "शिव एव सदा जीवो जीव एव सदा शिवः ।\nवेत्त्यैक्यमनयोर्यस्तु स आत्मज्ञो न चेतरः",
    "verse_number": "74",
    "char_count": 75
  },
  {
    "chunk_id": "advaitanubhuti_075",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "क्षीरयोगाद्यथा नीरं क्षीरवद्दृश्यते मृषा ।\nआत्मयोगादनात्मायमात्मवद्दृश्यते तथा",
    "verse_number": "75",
    "char_count": 78
  },
  {
    "chunk_id": "advaitanubhuti_076",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "नीरात्क्षीरं पृथक्कृत्य हंसो भवति नान्यथा ।\nस्थूलादेः स्वं पृथक्कृत्य मुक्तो भवति नान्यथा",
    "verse_number": "76",
    "char_count": 89
  },
  {
    "chunk_id": "advaitanubhuti_077",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "क्षीरनीरविवेकज्ञो हंस एव न चेतरः ।\nआत्मानात्मविवेकज्ञो यतिरेव न चेतरः",
    "verse_number": "77",
    "char_count": 69
  },
  {
    "chunk_id": "advaitanubhuti_078",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अध्यस्तचोरजः स्थाणोर्विकारः स्यान्न हि क्वचित् ।\nनात्मनो निर्विकारस्य विकारो विश्वजस्तथा",
    "verse_number": "78",
    "char_count": 88
  },
  {
    "chunk_id": "advaitanubhuti_079",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "ज्ञाते स्थाणौ कुतश्चोरश्चोराभावे भयं कुतः ।\nज्ञाते स्वस्मिन्कुतो विश्वं विश्वाभावे कुतोऽखिलम्",
    "verse_number": "79",
    "char_count": 93
  },
  {
    "chunk_id": "advaitanubhuti_080",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "गुणवृत्तित्रयं भाति परस्परविलक्षणम् ।\nसत्यात्मलक्षणे यस्मिन्स एवाहं निरंशकः",
    "verse_number": "80",
    "char_count": 75
  },
  {
    "chunk_id": "advaitanubhuti_081",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "देहत्रयमिदं भाति यस्मिन्ब्रह्मणि सत्यवत् ।\nतदेवाहं परं ब्रह्म देहत्रयविलक्षणः",
    "verse_number": "81",
    "char_count": 77
  },
  {
    "chunk_id": "advaitanubhuti_082",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "जाग्रदादित्रयं यस्मिन्प्रत्यगात्मनि सत्यवत् ।\nस एवाहं परं ब्रह्म जाग्रदादिविलक्षणः",
    "verse_number": "82",
    "char_count": 82
  },
  {
    "chunk_id": "advaitanubhuti_083",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "विश्वादिकत्रयं यस्मिन्परमात्मनि सत्यवत् ।\nस एव परमात्माहं विश्वादिकविलक्षणः",
    "verse_number": "83",
    "char_count": 75
  },
  {
    "chunk_id": "advaitanubhuti_084",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "विराडादित्रयं भाति यस्मिन्साक्षिणि सत्यवत् ।\nस एव सच्चिदानन्दलक्षणोऽहं स्वयंप्रभः",
    "verse_number": "84",
    "char_count": 81
  },
  {
    "chunk_id": "advaitanubhuti_085",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "इति श्रीमत्परमहंसपरिव्राजकाचार्यस्य\nश्रीगोविन्दभगवत्पूज्यपादशिष्यस्य\nश्रीमच्छंकरभगवतः कृतौ\nअद्वैतानुभूतिः सम्पूर्णा",
    "verse_number": "85",
    "char_count": 115
  },
  {
    "chunk_id": "advaitanubhuti_086",
    "text_name": "advaitanubhuti",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "Pलेअसे सेन्द् चोर्रेच्तिओन्स् तो सन्स्क्रित् अत् चीर्फ़ुल् दोत् च् ओम्\nळस्त् उप्दतेद् \\तोदय्\nह्त्त्प्स्://सन्स्क्रित्दोचुमेन्त्स्।ओर्ग्",
    "verse_number": "86",
    "char_count": 134
  }
