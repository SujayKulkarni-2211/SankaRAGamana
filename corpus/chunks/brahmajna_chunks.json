[
  {
    "chunk_id": "brahmajna_001",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सकृच्छ्रवणमात्रेण ब्रह्मज्ञानं यतो भवेत् ।\nब्रह्मज्ञानावलीमाला सर्वेषां मोक्षसिद्धये",
    "verse_number": "1",
    "char_count": 84
  },
  {
    "chunk_id": "brahmajna_002",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "असङ्गोऽहमसङ्गोऽहमसङ्गोऽहं पुनः पुनः ।\nसच्चिदानन्दरूपोऽहमहमेवाहमव्ययः",
    "verse_number": "2",
    "char_count": 68
  },
  {
    "chunk_id": "brahmajna_003",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "नित्यशुद्धविमुक्तोऽहं निराकारोऽहमव्ययः ।\nभूमानन्दस्वरूपोऽहमहमेवाहमव्ययः",
    "verse_number": "3",
    "char_count": 71
  },
  {
    "chunk_id": "brahmajna_004",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "नित्योऽहं निरवद्योऽहं निराकारोऽहमुच्यते ।\nपरमानन्दरूपोऽहमहमेवाहमव्ययः",
    "verse_number": "4",
    "char_count": 69
  },
  {
    "chunk_id": "brahmajna_005",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "शुद्धचैतन्यरूपोऽहमात्मारामोऽहमेव च ।\nअखण्डानन्दरूपोऽहमहमेवाहमव्ययः",
    "verse_number": "5",
    "char_count": 66
  },
  {
    "chunk_id": "brahmajna_006",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "प्रत्यक्चैतन्यरूपोऽहं शान्तोऽहं प्रकृतेः परः ।\nशाश्वतानन्दरूपोऽहमहमेवाहमव्ययः",
    "verse_number": "6",
    "char_count": 77
  },
  {
    "chunk_id": "brahmajna_007",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तत्त्वातीतः परात्माहं मध्यातीतः परः शिवः ।\nमायातीतः परंज्योतिरहमेवाहमव्ययः",
    "verse_number": "7",
    "char_count": 74
  },
  {
    "chunk_id": "brahmajna_008",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "नानारूपव्यतीतोऽहं चिदाकारोऽहमच्युतः ।\nसुखरूपस्वरूपोऽहमहमेवाहमव्ययः",
    "verse_number": "8",
    "char_count": 66
  },
  {
    "chunk_id": "brahmajna_009",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "मायातत्कार्यदेहादि मम नास्त्येव सर्वदा ।\nस्वप्रकाशैकरूपोऽहमहमेवाहमव्ययः",
    "verse_number": "9",
    "char_count": 71
  },
  {
    "chunk_id": "brahmajna_010",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "गुणत्रयव्यतीतोऽहं ब्रह्मादीनां च साक्ष्यहम् ।\nअनन्तानन्तरूपोऽहमहमेवाहमव्ययः",
    "verse_number": "10",
    "char_count": 75
  },
  {
    "chunk_id": "brahmajna_011",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अन्तर्यामिस्वरूपोऽहं कूटस्थः सर्वगोऽस्म्यहम् ।\nपरमात्मस्वरूपोऽहमहमेवाहमव्ययः",
    "verse_number": "11",
    "char_count": 76
  },
  {
    "chunk_id": "brahmajna_012",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "निष्कलोऽहं निष्क्रियोऽहं सर्वात्माद्यः सनातनः ।\nअपरोक्षस्वरूपोऽहमहमेवाहमव्ययः",
    "verse_number": "12",
    "char_count": 77
  },
  {
    "chunk_id": "brahmajna_013",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "द्वन्द्वादिसाक्षिरूपोऽहमचलोऽहं सनातनः ।\nसर्वसाक्षिस्वरूपोऽहमहमेवाहमव्ययः",
    "verse_number": "13",
    "char_count": 72
  },
  {
    "chunk_id": "brahmajna_014",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "प्रज्ञानघन एवाहं विज्ञानघन एव च ।\nअकर्ताहमभोक्ताहमहमेवाहमव्ययः",
    "verse_number": "14",
    "char_count": 62
  },
  {
    "chunk_id": "brahmajna_015",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "निराधारस्वरूपोऽहं सर्वाधारोऽहमेव च ।\nआप्तकामस्वरूपोऽहमहमेवाहमव्ययः",
    "verse_number": "15",
    "char_count": 66
  },
  {
    "chunk_id": "brahmajna_016",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तापत्रयविनिर्मुक्तो देहत्रयविलक्षणः ।\nअवस्थात्रयसाक्ष्यस्मि चाहमेवाहमव्ययः",
    "verse_number": "16",
    "char_count": 74
  },
  {
    "chunk_id": "brahmajna_017",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "दृग्दृश्यौ द्वौ पदार्थौ स्तः परस्परविलक्षणौ ।\nदृग्ब्रह्म दृश्यं मायेति सर्ववेदान्तडिण्डिमः",
    "verse_number": "17",
    "char_count": 90
  },
  {
    "chunk_id": "brahmajna_018",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अहं साक्षीति यो विद्याद्विविच्यैवं पुनः पुनः ।\nस एव मुक्तः सो विद्वानिति वेदान्तडिण्डिमः",
    "verse_number": "18",
    "char_count": 88
  },
  {
    "chunk_id": "brahmajna_019",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "घटकुड्यादिकं सर्वं मृत्तिकामात्रमेव च ।\nतद्वद्ब्रह्म जगत्सर्वमिति वेदान्तडिण्डिमः",
    "verse_number": "19",
    "char_count": 81
  },
  {
    "chunk_id": "brahmajna_020",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "ब्रह्म सत्यं जगन्मिथ्या जीवो ब्रह्मैव नापरः ।\nअनेन वेद्यं सच्छास्त्रमिति वेदान्तडिण्डिमः",
    "verse_number": "20",
    "char_count": 88
  },
  {
    "chunk_id": "brahmajna_021",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अन्तर्ज्योतिर्बहिर्ज्योतिः प्रत्यग्ज्योतिः परात्परः ।\nज्योतिर्ज्योतिः स्वयंज्योतिरात्मज्योतिः शिवोऽस्म्यहम्",
    "verse_number": "21",
    "char_count": 107
  },
  {
    "chunk_id": "brahmajna_022",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "इति श्रीमत्परमहंसपरिव्राजकाचार्यस्य\nश्रीगोविन्दभगवत्पूज्यपादशिष्यस्य\nश्रीमच्छङ्करभगवतः कृतौ\nब्रह्मज्ञानावलीमाला सम्पूर्णा",
    "verse_number": "22",
    "char_count": 121
  },
  {
    "chunk_id": "brahmajna_023",
    "text_name": "brahmajna",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "Eन्चोदेद् ब्य् षुन्देर् ःअत्तन्गदि\n\n\nPलेअसे सेन्द् चोर्रेच्तिओन्स् तो सन्स्क्रित् अत् चीर्फ़ुल् दोत् च् ओम्\nळस्त् उप्दतेद् \\तोदय्\nह्त्त्प्स्://सन्स्क्रित्दोचुमेन्त्स्।ओर्ग्",
    "verse_number": "23",
    "char_count": 171
  }
]