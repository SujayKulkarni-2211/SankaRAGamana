[
  {
    "chunk_id": "drigdrishyaviveka_001",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "भारती तीर्थ स्वामिना विरचितः\n\nरूपं दृश्यं लोचनं दृक् तद्दृश्यं दृक्तु मानसम् ।\nदृश्या धीवृत्तयः साक्षी दृगेव न तु दृश्यते",
    "verse_number": "1",
    "char_count": 121
  },
  {
    "chunk_id": "drigdrishyaviveka_002",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "नीलपीतस्थूलसूक्ष्मह्रस्वदीर्घादि भेदतः ।\nनानाविधानि रूपाणि पश्येल्लोचनमेकधा",
    "verse_number": "2",
    "char_count": 75
  },
  {
    "chunk_id": "drigdrishyaviveka_003",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "आन्ध्यमान्द्यपटुत्वेषु नेत्रधर्मेषु चैकधा ।\nसङ्कल्पयेन्मनः श्रोत्रत्वगादौ योज्यतामिदम्",
    "verse_number": "3",
    "char_count": 86
  },
  {
    "chunk_id": "drigdrishyaviveka_004",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कामः सङ्कल्पसन्देहौ श्रद्धाऽश्रद्धे धृतीतरे ।\nह्रीर्धीर्भीरित्येवमादीन् भासयत्येकधा चितिः",
    "verse_number": "4",
    "char_count": 89
  },
  {
    "chunk_id": "drigdrishyaviveka_005",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "नोदेति नास्तमेत्येषा न वृद्धिं याति न क्षयम् ।\nस्वयं विभात्यथान्यानि भासयेत्साधनं विना",
    "verse_number": "5",
    "char_count": 86
  },
  {
    "chunk_id": "drigdrishyaviveka_006",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "चिच्छायाऽऽवेशतो बुद्धौ भानं धीस्तु द्विधा स्थिता ।\nएकाहङ्कृतिरन्या स्यादन्तःकरणरूपिणी",
    "verse_number": "6",
    "char_count": 85
  },
  {
    "chunk_id": "drigdrishyaviveka_007",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "छायाऽहङ्कारयोरैक्यं तप्तायःपिण्डवन्मतम् ।\nतदहङ्कारतादात्म्याद्देहश्चेतनतामगात्",
    "verse_number": "7",
    "char_count": 78
  },
  {
    "chunk_id": "drigdrishyaviveka_008",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अहङ्कारस्य तादात्म्यं चिच्छायादेहसाक्षिभिः ।\nसहजं कर्मजं भ्रान्तिजन्यं च त्रिविधं क्रमात्",
    "verse_number": "8",
    "char_count": 89
  },
  {
    "chunk_id": "drigdrishyaviveka_009",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सम्बन्धिनोः सतोर्नास्ति निवृत्तिः सहजस्य तु ।\nकर्मक्षयात् प्रबोधाच्च निवर्तेते क्रमादुभे",
    "verse_number": "9",
    "char_count": 88
  },
  {
    "chunk_id": "drigdrishyaviveka_010",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अहङ्कारलये सुप्तौ भवेद्देहोऽप्यचेतनः ।\nअहङ्कारविकासार्धः स्वप्नः सर्वस्तु जागरः",
    "verse_number": "10",
    "char_count": 79
  },
  {
    "chunk_id": "drigdrishyaviveka_011",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अन्तःकरणवृत्तिश्च चितिच्छायैक्यमागता ।\nवासनाः कल्पयेत् स्वप्ने बोधेऽक्षैर्विषयान् बहिः",
    "verse_number": "11",
    "char_count": 86
  },
  {
    "chunk_id": "drigdrishyaviveka_012",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "मनोऽहङ्कृत्युपादानं लिङ्गमेकं जडात्मकम् ।\nअवस्थात्रयमन्वेति जायते म्रियते तथा",
    "verse_number": "12",
    "char_count": 77
  },
  {
    "chunk_id": "drigdrishyaviveka_013",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "शक्तिद्वयं हि मायाया विक्षेपावृतिरूपकम् ।\nविक्षेपशक्तिर्लिङ्गादि ब्रह्माण्डान्तं जगत् सृजेत्",
    "verse_number": "13",
    "char_count": 92
  },
  {
    "chunk_id": "drigdrishyaviveka_014",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सृष्टिर्नाम ब्रह्मरूपे सच्चिदानन्दवस्तुनि ।\nअब्धौ फेनादिवत् सर्वनामरूपप्रसारणा",
    "verse_number": "14",
    "char_count": 78
  },
  {
    "chunk_id": "drigdrishyaviveka_015",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अन्तर्दृग्दृश्ययोर्भेदं बहिश्च ब्रह्मसर्गयोः ।\nआवृणोत्यपरा शक्तिः सा संसारस्य कारणम्",
    "verse_number": "15",
    "char_count": 84
  },
  {
    "chunk_id": "drigdrishyaviveka_016",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "साक्षिणः पुरतो भाति लिङ्गं देहेन संयुतम् ।\nचितिच्छाया समावेशाज्जीवः स्याद्व्यावहारिकः",
    "verse_number": "16",
    "char_count": 85
  },
  {
    "chunk_id": "drigdrishyaviveka_017",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अस्य जीवत्वमारोपात् साक्षिण्यप्यवभासते ।\nआवृतौ तु विनष्टायां भेदे भातेऽपयाति तत्",
    "verse_number": "17",
    "char_count": 80
  },
  {
    "chunk_id": "drigdrishyaviveka_018",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तथा सर्गब्रह्मणोश्च भेदमावृत्य तिष्ठति ।\nया शक्तिस्तद्वशाद्ब्रह्म विकृतत्वेन भासते",
    "verse_number": "18",
    "char_count": 82
  },
  {
    "chunk_id": "drigdrishyaviveka_019",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अत्राप्यावृतिनाशेन विभाति ब्रह्मसर्गयोः ।\nभेदस्तयोर्विकारः स्यात् सर्गे न ब्रह्मणि क्वचित्",
    "verse_number": "19",
    "char_count": 90
  },
  {
    "chunk_id": "drigdrishyaviveka_020",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अस्ति भाति प्रियं रूपं नाम चेत्यंशपञ्चकम् ।\nआद्यत्रयं ब्रह्मरूपं जगद्रूपं ततो द्वयम्",
    "verse_number": "20",
    "char_count": 84
  },
  {
    "chunk_id": "drigdrishyaviveka_021",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "खवाय्वग्निजलोर्वीषु देवतिर्यङ्नरादिषु ।\nअभिन्नाः सच्चिदानन्दाः भिद्येते रूपनामनी",
    "verse_number": "21",
    "char_count": 80
  },
  {
    "chunk_id": "drigdrishyaviveka_022",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "उपेक्ष्य नामरूपे द्वे सच्चिदानन्दतत्परः ।\nसमाधिं सर्वदा कुर्याद्।ह्\\-हृदये वाऽथवा बहिः",
    "verse_number": "22",
    "char_count": 86
  },
  {
    "chunk_id": "drigdrishyaviveka_023",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सविकल्पो निर्विकल्पः समाधिर्द्विविधो हृदि ।\nदृश्यशब्दानुविद्धेन सविकल्पः पुनर्द्विधा",
    "verse_number": "23",
    "char_count": 84
  },
  {
    "chunk_id": "drigdrishyaviveka_024",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "(सरस्वतीरहस्योपनिषदे शब्दानुभेदेन, शब्दानुवेधेन)\n\nकामाद्याश्चित्तगा दृश्यास्तत्साक्षित्वेन चेतनम् ।\nध्यायेद्दृश्यानुविद्धोऽयं समाधिः सविकल्पकः",
    "verse_number": "24",
    "char_count": 142
  },
  {
    "chunk_id": "drigdrishyaviveka_025",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "असङ्गः सच्चिदानन्दः स्वप्रभो द्वैतवर्जितः ।\nअस्मीति शब्दविद्धोऽयं समाधिः सविकल्पकः",
    "verse_number": "25",
    "char_count": 82
  },
  {
    "chunk_id": "drigdrishyaviveka_026",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "स्वानुभूतिरसावेशाद्दृश्यशब्दावुपेक्ष्य तु ।\nनिर्विकल्पः समाधिः स्यान्निवातस्थितदीपवत्",
    "verse_number": "26",
    "char_count": 85
  },
  {
    "chunk_id": "drigdrishyaviveka_027",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "हृदीव बाह्यदेशेऽपि यस्मिन् कस्मिंश्च वस्तुनि ।\nसमाधिराद्यः सन्मात्रान्नामरूपपृथक्कृतिः",
    "verse_number": "27",
    "char_count": 86
  },
  {
    "chunk_id": "drigdrishyaviveka_028",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अखण्डैकरसं वस्तु सच्चिदानन्दलक्षणम् ।\nइत्यविच्छिन्नचिन्तेयं समाधिर्मध्यमो भवेत्",
    "verse_number": "28",
    "char_count": 79
  },
  {
    "chunk_id": "drigdrishyaviveka_029",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "स्तब्धीभावो रसास्वादात्तृतीयः पूर्ववन्मतः ।\nएतैः समाधिभिः षड्भिर्नयेत् कालं निरन्तरम्",
    "verse_number": "29",
    "char_count": 85
  },
  {
    "chunk_id": "drigdrishyaviveka_030",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "देहाभिमाने गलिते विज्ञाते परमात्मनि ।\nयत्र यत्र मनो याति तत्र तत्र समाधयः",
    "verse_number": "30",
    "char_count": 73
  },
  {
    "chunk_id": "drigdrishyaviveka_031",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "भिद्यते हृदयग्रन्थिश्छिद्यन्ते सर्वसंशयाः ।\nक्षीयन्ते चास्य कर्माणि तस्मिन् दृष्टे परावरे",
    "verse_number": "31",
    "char_count": 89
  },
  {
    "chunk_id": "drigdrishyaviveka_032",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अवच्छिन्नश्चिदाभासस्तृतीयः स्वप्नकल्पितः ।\nविज्ञेयस्त्रिविधो जीवस्तत्राद्यः पारमार्थिकः",
    "verse_number": "32",
    "char_count": 87
  },
  {
    "chunk_id": "drigdrishyaviveka_033",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अवच्छेदः कल्पितः स्यादवच्छेद्यं तु वास्तवम् ।\nतस्मिन् जीवत्वमारोपाद्ब्रह्मत्वं तु स्वभावतः",
    "verse_number": "33",
    "char_count": 90
  },
  {
    "chunk_id": "drigdrishyaviveka_034",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अवच्छिन्नस्य जीवस्य पूर्णेन ब्रह्मणैकताम् ।\nतत्त्वमस्यादिवाक्यानि जगुर्नेतरजीवयोः",
    "verse_number": "34",
    "char_count": 81
  },
  {
    "chunk_id": "drigdrishyaviveka_035",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "ब्रह्मण्यवस्थिता माया विक्षेपावृतिरूपिणी ।\nआवृत्याखण्डतां तस्मिन् जगज्जीवौ प्रकल्पयेत्",
    "verse_number": "35",
    "char_count": 86
  },
  {
    "chunk_id": "drigdrishyaviveka_036",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "जीवो धीस्थचिदाभासो भवेद्भोक्ता हि कर्मकृत् ।\nभोग्यरूपमिदं सर्वं जगत् स्याद्भूतभौतिकम्",
    "verse_number": "36",
    "char_count": 85
  },
  {
    "chunk_id": "drigdrishyaviveka_037",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अनादिकालमारभ्य मोक्षात् पूर्वमिदं द्वयम् ।\nव्यवहारे स्थितं तस्मादुभयं व्यावहारिकम्",
    "verse_number": "37",
    "char_count": 82
  },
  {
    "chunk_id": "drigdrishyaviveka_038",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "चिदाभासस्थिता निद्रा विक्षेपावृतिरूपिणी ।\nआवृत्य जीवजगती पूर्वे नूत्ने तु कल्पयेत्",
    "verse_number": "38",
    "char_count": 82
  },
  {
    "chunk_id": "drigdrishyaviveka_039",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "प्रतीतिकाल एवैते स्थितत्वात् प्रातिभासिके ।\nन हि स्वप्नप्रबुद्धस्य पुनः स्वप्ने स्थितिस्तयोः",
    "verse_number": "39",
    "char_count": 92
  },
  {
    "chunk_id": "drigdrishyaviveka_040",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "प्रातिभासिकजीवो यस्तज्जगत् प्रातिभासिकम् ।\nवास्तवं मन्यतेऽन्यस्तु मिथ्येति व्यावहारिकः",
    "verse_number": "40",
    "char_count": 86
  },
  {
    "chunk_id": "drigdrishyaviveka_041",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "व्यावहारिकजीवो यस्तज्जगद्व्यावहारिकम् ।\nसत्यं प्रत्येति मिथ्येति मन्यते पारमार्थिकः",
    "verse_number": "41",
    "char_count": 83
  },
  {
    "chunk_id": "drigdrishyaviveka_042",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "पारमार्थिकजीवस्तु ब्रह्मैक्यं पारमार्थिकम् ।\nप्रत्येति वीक्षते नान्यद्वीक्षते त्वनृतात्मना",
    "verse_number": "42",
    "char_count": 90
  },
  {
    "chunk_id": "drigdrishyaviveka_043",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "माधुर्यद्रवशैत्यानि नीरधर्मास्तरङ्गके ।\nअनुगम्याथ तन्निष्ठे फेनेऽप्यनुगता यथा",
    "verse_number": "43",
    "char_count": 77
  },
  {
    "chunk_id": "drigdrishyaviveka_044",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "साक्षिस्थाः सच्चिदानन्दाः सम्बन्धाद्व्यावहारिके ।\nतद्द्वारेणानुगच्छन्ति तथैव प्रातिभासिके",
    "verse_number": "44",
    "char_count": 89
  },
  {
    "chunk_id": "drigdrishyaviveka_045",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "लये फेनस्य तद्धर्मा द्रवाद्याः स्युस्तरङ्गके ।\nतस्यापि विलये नीरे तिष्ठन्त्येते यथा पुरा",
    "verse_number": "45",
    "char_count": 88
  },
  {
    "chunk_id": "drigdrishyaviveka_046",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "प्रातिभासिकजीवस्य लये स्युर्व्यावहारिके ।\nतल्लये सच्चिदानन्दाः पर्यवस्यन्ति साक्षिणि",
    "verse_number": "46",
    "char_count": 84
  },
  {
    "chunk_id": "drigdrishyaviveka_047",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "इति भारती तीर्थ स्वामिना विरचितः\nदृग्दृश्यविवेकः समाप्तः",
    "verse_number": "47",
    "char_count": 56
  },
  {
    "chunk_id": "drigdrishyaviveka_048",
    "text_name": "drigdrishyaviveka",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "Eन्चोदेद् अन्द् प्रूफ़्रेअद् ब्य् षुन्देर् ःअत्तन्गदि\n\n\nPलेअसे सेन्द् चोर्रेच्तिओन्स् तो सन्स्क्रित्@चीर्फ़ुल्ॅओम्\nळस्त् उप्दतेद् \\तोदय्\nह्त्त्प्स्://सन्स्क्रित्दोचुमेन्त्स्।ओर्ग्",
    "verse_number": "48",
    "char_count": 177
  }
]