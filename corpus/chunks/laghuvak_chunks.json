[
  {
    "chunk_id": "laghuvak_001",
    "text_name": "laghuvak",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "स्थूलो मांसमयो देहो सूक्ष्मः स्याद्वासनामयः ।\nज्ञानकर्मेन्द्रियैः सार्धं धीप्राणौ तच्छरीरगौ",
    "verse_number": "1",
    "char_count": 91
  },
  {
    "chunk_id": "laghuvak_002",
    "text_name": "laghuvak",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अज्ञानं कारणं साक्षी बोधस्तेषां विभासकः ।\nबोधाभासो बुद्धिगतः कर्ता स्यात्पुण्यपापयोः",
    "verse_number": "2",
    "char_count": 84
  },
  {
    "chunk_id": "laghuvak_003",
    "text_name": "laghuvak",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "स एव संसरेत्कर्मवशाल्लोकद्वये सदा ।\nबोधाभासाच्छुद्धबोधं विविच्यादतियत्नतः",
    "verse_number": "3",
    "char_count": 73
  },
  {
    "chunk_id": "laghuvak_004",
    "text_name": "laghuvak",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "जागरस्वप्नयोरेव बोधाभासविडम्बना ।\nसुप्तौ तु तल्लये बोधः शुद्धो जाड्यं प्रकाशयेत्",
    "verse_number": "4",
    "char_count": 80
  },
  {
    "chunk_id": "laghuvak_005",
    "text_name": "laghuvak",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "जागरेऽपि धियस्तूष्णीम्भावः शुद्धेन भास्यते ।\nधीव्यापाराश्च चिद्भास्याश्चिदाभासेन संयुताः",
    "verse_number": "5",
    "char_count": 88
  },
  {
    "chunk_id": "laghuvak_006",
    "text_name": "laghuvak",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "वह्नितप्तजलं तापयुक्तं देहस्य तापकम् ।\nचिद्भास्या धीस्तदाभासयुक्तान्यं भासयेत्तथा",
    "verse_number": "6",
    "char_count": 81
  },
  {
    "chunk_id": "laghuvak_007",
    "text_name": "laghuvak",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "रूपादौ गुणदोषादिविकल्पा बुद्धिगाः क्रियाः ।\nताः क्रिया विषयैः सार्धं भासयन्ती चितिर्मता",
    "verse_number": "7",
    "char_count": 87
  },
  {
    "chunk_id": "laghuvak_008",
    "text_name": "laghuvak",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "रूपाच्च गुणदोषाभ्यां विविक्ता केवला चितिः ।\nसैवानुवर्तते रूपरसादीनां विकल्पने",
    "verse_number": "8",
    "char_count": 77
  },
  {
    "chunk_id": "laghuvak_009",
    "text_name": "laghuvak",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "क्षणे क्षणेऽन्यथाभूता धीविकल्पाश्चितिर्न तु ।\nमुक्तासु सूत्रवद्बुद्धिविकल्पेषु चितिस्तथा",
    "verse_number": "9",
    "char_count": 88
  },
  {
    "chunk_id": "laghuvak_010",
    "text_name": "laghuvak",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "मुक्ताभिरावृतं सूत्रं मुक्तयोर्मध्य ईक्ष्यते ।\nतथा वृत्तिविकल्पैश्चित्स्पष्टा मध्ये विकल्पयोः",
    "verse_number": "10",
    "char_count": 93
  },
  {
    "chunk_id": "laghuvak_011",
    "text_name": "laghuvak",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "नष्टे पूर्वविकल्पे तु यावदन्यस्य नोदयः ।\nनिर्विकल्पकचैतन्यं स्पष्टं तावद्विभासते",
    "verse_number": "11",
    "char_count": 80
  },
  {
    "chunk_id": "laghuvak_012",
    "text_name": "laghuvak",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "एकद्वित्रिक्षणेष्वेवं विकल्पस्य निरोधनम् ।\nक्रमेणाभ्यस्यतां यत्नाद्ब्रह्मानुभवकाङ्क्षिभिः",
    "verse_number": "12",
    "char_count": 89
  },
  {
    "chunk_id": "laghuvak_013",
    "text_name": "laghuvak",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सविकल्पजीवोऽयं ब्रह्म तन्निर्विकल्पकम् ।\nअहं ब्रह्मेति वाक्येन सोऽयमर्थोऽभिधीयते",
    "verse_number": "13",
    "char_count": 80
  },
  {
    "chunk_id": "laghuvak_014",
    "text_name": "laghuvak",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सविकल्पकचिद्योऽहं ब्रह्मैकं निर्विकल्पकम् ।\nस्वतःसिद्धा विकल्पास्ते निरोद्धव्याः प्रयत्नतः",
    "verse_number": "14",
    "char_count": 90
  },
  {
    "chunk_id": "laghuvak_015",
    "text_name": "laghuvak",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "शक्यः सर्वनिरोधेन समाधिर्योगिनं प्रियः ।\nतदशक्तौ क्षणं रुद्ध्वा श्रद्धालुर्ब्रह्मतात्मनः",
    "verse_number": "15",
    "char_count": 88
  },
  {
    "chunk_id": "laghuvak_016",
    "text_name": "laghuvak",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "श्रद्धालुर्ब्रह्मतां स्वस्य चिन्तयेद्बुद्धिवृत्तिभिः ।\nवाक्यवृत्त्या यथाशक्ति ज्ञात्वाद्धाभ्यस्यतां सदा",
    "verse_number": "16",
    "char_count": 103
  },
  {
    "chunk_id": "laghuvak_017",
    "text_name": "laghuvak",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तच्चिन्तनं तत्कथनमन्योन्यं तत्प्रबोधनम् ।\nएतदेकपरत्वं च ब्रह्माभ्यासं विदुर्बुधाः",
    "verse_number": "17",
    "char_count": 81
  },
  {
    "chunk_id": "laghuvak_018",
    "text_name": "laghuvak",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "देहात्मधीवद्ब्रह्मात्मधीदार्ढ्ये कृतकृत्यता ।\nयदा तदायं म्रियतां मुक्तोऽसौ नात्र संशयः",
    "verse_number": "18",
    "char_count": 86
  },
  {
    "chunk_id": "laghuvak_019",
    "text_name": "laghuvak",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "इति श्रीमत्परमहंसपरिव्राजकाचार्यस्य\nश्रीगोविन्दभगवत्पूज्यपादशिष्यस्य\nश्रीमच्छङ्करभगवतः कृतौ\nलघुवाक्यवृत्तिः सम्पूर्णा",
    "verse_number": "19",
    "char_count": 117
  },
  {
    "chunk_id": "laghuvak_020",
    "text_name": "laghuvak",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "Eन्चोदेद् ब्य् षुन्देर् ःअत्तन्गदि\n\n\nPलेअसे सेन्द् चोर्रेच्तिओन्स् तो सन्स्क्रित्@चीर्फ़ुल्ॅओम्\nळस्त् उप्दतेद् \\तोदय्\nह्त्त्प्स्://सन्स्क्रित्दोचुमेन्त्स्।ओर्ग्",
    "verse_number": "20",
    "char_count": 159
  }
]