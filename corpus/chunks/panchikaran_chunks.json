[
  {
    "chunk_id": "panchikaran_001",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "ॐ\nश्रीमच्छङ्कराचार्यविरचितम् पञ्चीकरणम्\nॐ पञ्चीकृतम्पञ्चमहाभूतानि तत्कार्यं\n      च सर्वं विराडित्युच्यते ।\nएतत्स्थुलशरिरमात्मनः ।\n      ईन्द्रियैरर्थोपलब्धिर्जागरितम् ।\n      तदुभयाभिमान्यात्मा विश्वः ।\nएतत् त्रयमकारः",
    "verse_number": "1",
    "char_count": 218
  },
  {
    "chunk_id": "panchikaran_002",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अपञ्चीकृतपञ्चमहाभूतानि पञ्चतन्मात्रणि\n     तत्कार्यं च पञ्च प्राणाः दशेन्द्रियाणि\n     मनोबुद्धिश्चेति सप्तदशकं लिङ्कम् भौतिकं\n     हिरण्यगर्भ इत्युच्यते ।\nएतत्सूक्ष्मशरिरमात्मनः",
    "verse_number": "2",
    "char_count": 178
  },
  {
    "chunk_id": "panchikaran_003",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "करणेषूपसंहृतेषु जागरितसंस्कारजः प्रत्ययः\n     सविषयः स्वप्न इत्युच्यते ।\nयदुभयाभिमान्यात्मा तैजसः ।\nएतत् त्रयमुकारः",
    "verse_number": "3",
    "char_count": 115
  },
  {
    "chunk_id": "panchikaran_004",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "शरीरद्वयकारणमात्माज्ञानं\nसाभासमव्याकृतमित्युच्यते ।\n     एतत् कारणशरीरमात्मनः ।\nतच्च न सन्नासन्नापि सदसन्न भिन्नं नाभिन्नं\n     नापि भिन्नाभिन्नं कुतश्चित्\nन निरवयवं न सावयवं\n     नोभयं किन्तु\nकेवलब्रह्मात्मैकत्वज्ञानापनोद्यम्",
    "verse_number": "4",
    "char_count": 226
  },
  {
    "chunk_id": "panchikaran_005",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सर्वप्रकारज्ञानोपसंहारे बुद्धेः\n     कारणात्मनाऽवस्थानं सुषुप्तिः ।\n     तदुभयामिमान्यात्मा प्राज्ञः ।\nएतत् त्रयम् मकारः",
    "verse_number": "5",
    "char_count": 120
  },
  {
    "chunk_id": "panchikaran_006",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अकार उकारे उकारो मकारे मकार ओङ्कारे\nओङ्कारोऽहम्येव ।\nअहमात्मा साक्षी केवलश्चिन्मात्रस्वरूपः\n     नाज्ञानं नापि तत्कार्यं किन्तु\n     नित्यशुद्धबुद्धमुक्तसत्यस्भावं\n     परमानन्दाद्वयं प्रत्यग्भूतचैतन्यं ब्रह्मै\n     वाहमस्मीत्यभेदेनावस्थानं समाधिः",
    "verse_number": "6",
    "char_count": 247
  },
  {
    "chunk_id": "panchikaran_007",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तत्त्वमसि ब्रह्महमस्मि प्रज्ञानमानन्दं ब्रह्म\n     अयमात्मा ब्रह्म इत्यादिश्रुतिभ्यः",
    "verse_number": "7",
    "char_count": 84
  },
  {
    "chunk_id": "panchikaran_008",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "इति श्रीशङ्कराचार्यविरचितं पञ्चीकरणम्",
    "verse_number": "8",
    "char_count": 37
  },
  {
    "chunk_id": "panchikaran_009",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "पञ्चीकरणवार्त्तिकम्\n            श्रीसुरेश्वराचार्यकृत\nॐकारः सर्ववेदानां सारस्तत्त्वप्रकाशकः ।\nतेन चित्तसमाधानं मुमुक्षूणां प्रकाश्यते",
    "verse_number": "9",
    "char_count": 133
  },
  {
    "chunk_id": "panchikaran_010",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "आसीदेकं परं ब्रह्म नित्यमुक्तमवीक्रियम् ।\nतत्स्वमायासमावेशाद् बीजमव्याकृतात्मकम्",
    "verse_number": "10",
    "char_count": 80
  },
  {
    "chunk_id": "panchikaran_011",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तस्मादाकाशमुत्पन्नं शब्दतन्मात्ररूपकम् ।\nस्पर्शात्मकस्ततो वायुस्तेजोरूपात्मकं ततः",
    "verse_number": "11",
    "char_count": 81
  },
  {
    "chunk_id": "panchikaran_012",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "आपो रसात्मिकास्तस्मात्ताभ्यो गन्धात्मिका महि ।\nशब्दैकगुणमाकाशं शब्दस्पर्शगुणो मरूत्",
    "verse_number": "12",
    "char_count": 83
  },
  {
    "chunk_id": "panchikaran_013",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "शब्दस्पर्शरूपगुणैस्त्रिगुणं तेज उच्यते ।\nशब्दस्पर्शरूपरसगुणैरापश्चतुर्गुणाः",
    "verse_number": "13",
    "char_count": 75
  },
  {
    "chunk_id": "panchikaran_014",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "शब्दस्पर्शरूपरसगन्धैः पञ्चगुणा मही ।\nतेभ्यः समभवत्सूत्रं भूतं सर्वात्मकं महत्",
    "verse_number": "14",
    "char_count": 77
  },
  {
    "chunk_id": "panchikaran_015",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "ततः स्थूलानि भूतानि पञ्च तेभ्यो विराडभूत् ।\nपञ्चीकृतानि भूतानि स्थूलानीत्युच्यते बुधैः",
    "verse_number": "15",
    "char_count": 86
  },
  {
    "chunk_id": "panchikaran_016",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "पृथिव्यादीनि भूतानि प्रत्येकं विभजेद् द्विधा ।\nएकैकं भागमादाय चतुर्धा विभजेत्पुनः",
    "verse_number": "16",
    "char_count": 81
  },
  {
    "chunk_id": "panchikaran_017",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "एकैकं भागमेकस्मिन् भूते संवेशयेत्क्रमात् ।\nततश्चाकाशभूतस्य भागाः पञ्च भवन्ति हि",
    "verse_number": "17",
    "char_count": 79
  },
  {
    "chunk_id": "panchikaran_018",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "वाय्वादिभागाश्च्त्वारो वाय्वादिष्वेवमादिशेत् ।\nपञ्चीकरणमेतत्स्यादित्यहुस्तत्त्ववेदिनः",
    "verse_number": "18",
    "char_count": 85
  },
  {
    "chunk_id": "panchikaran_019",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "पञ्चकृतानि भूतानि तत्कार्यं च विराड् भवेत् ।\nस्थूलं शरीरमेतत्स्यादशरीरस्य चात्मनः",
    "verse_number": "19",
    "char_count": 81
  },
  {
    "chunk_id": "panchikaran_020",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अधिदैवतमध्यात्ममधिभूतमिति त्रिधा ।\nएकं ब्रह्म विभागेन भ्रमाद्माति न तत्त्वत्तः",
    "verse_number": "20",
    "char_count": 78
  },
  {
    "chunk_id": "panchikaran_021",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "इन्द्रियैरर्थविज्ञानं देवतानुग्रहान्तिवतैः ।\nशब्दादिविषयं ज्ञानं तज्जागरितमुच्यते",
    "verse_number": "21",
    "char_count": 81
  },
  {
    "chunk_id": "panchikaran_022",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "श्रोत्रमध्यात्ममित्युक्तं श्रोतव्यं शब्दलक्षणम् ।\nअधिभूतं तदित्युक्तं दिशस्तत्राधिदैवतम्",
    "verse_number": "22",
    "char_count": 88
  },
  {
    "chunk_id": "panchikaran_023",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "त्वगध्यात्ममिति प्रोक्तं स्प्रष्टव्यं स्पर्शलक्षणम्\nअधिभूतं तदित्युक्तं वायुस्तत्रधिदैवतम्",
    "verse_number": "23",
    "char_count": 90
  },
  {
    "chunk_id": "panchikaran_024",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "चक्षुरध्यात्ममित्युक्तं द्रष्टव्यं रूपलक्षणम् ।\nअधिभूतं तदित्युक्तमादित्योऽत्राधिदैवतम्",
    "verse_number": "24",
    "char_count": 87
  },
  {
    "chunk_id": "panchikaran_025",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "जिह्वाऽध्यात्मं तयाऽस्वाद्यमाधिभूतं रसात्मकम् ।\nवरूणो देवता तत्र जिह्वायामधिदैवतम्",
    "verse_number": "25",
    "char_count": 82
  },
  {
    "chunk_id": "panchikaran_026",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "ध्राणमध्यात्ममित्युक्तं ध्रातव्यं गन्धलक्षणम् ।\nअधिभूतं तदित्युक्तं पृथिव्यत्राधिदैवतम्",
    "verse_number": "26",
    "char_count": 87
  },
  {
    "chunk_id": "panchikaran_027",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "वागध्यात्ममिति प्रोक्तं वक्त्वयं शब्दलक्षणम् ।\nअधिभूतं तदित्युक्तमग्निस्तत्राधिदैवतम्",
    "verse_number": "27",
    "char_count": 85
  },
  {
    "chunk_id": "panchikaran_028",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "हस्तावध्यात्ममित्युक्तमादातव्यं च यद्मवेत् ।\nअधिभूतं तदित्य्युक्तमिन्द्रस्तत्राधिदैचतम्",
    "verse_number": "28",
    "char_count": 87
  },
  {
    "chunk_id": "panchikaran_029",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "पादावध्यात्ममित्युक्तं गन्तव्यं तत्र यद्मवेत् ।\nअधिभूतं तदित्युक्तं विष्णुस्तत्राधिदैवतम्",
    "verse_number": "29",
    "char_count": 89
  },
  {
    "chunk_id": "panchikaran_030",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "पायुरिन्द्रियमध्यात्मं विसर्गस्तत्र यो भवेत् ।\nअधिभूतं तदित्युक्तम्ं मृत्युस्तत्राधिदैवतम्",
    "verse_number": "30",
    "char_count": 90
  },
  {
    "chunk_id": "panchikaran_031",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "उपस्थेन्द्रियमध्यात्मं स्त्र्याद्यानन्दस्य कारणम्\nअदिभूतं तदित्युक्तमधिदैवं प्रजापतिः",
    "verse_number": "31",
    "char_count": 85
  },
  {
    "chunk_id": "panchikaran_032",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "मनोऽध्यात्ममिति प्रोक्तं मन्तव्यं तत्र यद्मवेत् ।\nअधिभूतं तदित्युक्तं चन्द्रस्तत्राधिदैवतम्",
    "verse_number": "32",
    "char_count": 91
  },
  {
    "chunk_id": "panchikaran_033",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "बुद्धिरध्यात्ममित्युक्तं बोद्धव्यं तत्र यद्मवेत् ।\nअधिभूतं तदित्युक्तमधिदैवं बृहस्पतिः",
    "verse_number": "33",
    "char_count": 86
  },
  {
    "chunk_id": "panchikaran_034",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अहङ्कारस्तथाऽध्यात्ममहङ्कर्तव्यमेव च ।\nअधिभूतं तदित्युक्तं रुद्रस्तत्राधिदैवतम्",
    "verse_number": "34",
    "char_count": 79
  },
  {
    "chunk_id": "panchikaran_035",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "चितमध्यात्ममित्युक्तं चेतव्यं तत्र यद्मवेत् ।\nअधिभूतं तदित्युक्तं क्षेत्रज्ञोऽत्राधिदैवतम्",
    "verse_number": "35",
    "char_count": 90
  },
  {
    "chunk_id": "panchikaran_036",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तमोऽध्यात्ममत्मिति प्रोक्तं विकारस्तत्र यो भवेत् ।\nअधिभूतं तदित्युक्तमीश्वरोऽत्राधिदैवतम्",
    "verse_number": "36",
    "char_count": 89
  },
  {
    "chunk_id": "panchikaran_037",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "बाह्यान्तःकरणैरेवं देवतानुग्रहान्वितैः ।\nस्वं स्वं च विष्यज्ञानं तज्जागरितमुच्यते",
    "verse_number": "37",
    "char_count": 81
  },
  {
    "chunk_id": "panchikaran_038",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "२९\nयेयं जागरितावस्था शरीरं करणाश्रयम् ।\nयस्तयोरभिमानी स्यद्विश्व इत्यभिधीयते",
    "verse_number": "38",
    "char_count": 76
  },
  {
    "chunk_id": "panchikaran_039",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "विश्वं वैराजरूपेण पश्येद्मेदनिवृत्तये ।\nज्ञानेन्द्रियाणि पञ्चैव पञ्च कर्मेन्द्रियाणि च",
    "verse_number": "39",
    "char_count": 86
  },
  {
    "chunk_id": "panchikaran_040",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "श्रोत्रत्वङ्नयनघ्राणजिह्वा धीन्द्रियपञ्चकम् ।\nवाक्।ह्पाणिपादपायूपस्थाः कर्मेन्द्रियपञ्चकम्",
    "verse_number": "40",
    "char_count": 90
  },
  {
    "chunk_id": "panchikaran_041",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "मनोबुद्धिरहङ्कारश्चित्तं चेति चतुष्टयम् ।\nसङ्कल्पारव्यं मनोरूपं बुद्धिर्निश्चयरूपिणी",
    "verse_number": "41",
    "char_count": 84
  },
  {
    "chunk_id": "panchikaran_042",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अभिमानात्मकस्तद्वदहङ्कारः प्रकीर्तितः ।\nअनुसन्धानरूपम्ं च चित्तमित्यभिधीयते",
    "verse_number": "42",
    "char_count": 75
  },
  {
    "chunk_id": "panchikaran_043",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "प्राणोऽपानस्तथा व्यान उदानारव्यस्तथैव च ।\nसमानश्चेति पञ्चैताः किर्तिताः प्रणवृत्तयः",
    "verse_number": "43",
    "char_count": 83
  },
  {
    "chunk_id": "panchikaran_044",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "खवाव्यग्न्यम्बुक्षितयो भूतसूक्ष्माणि पञ्च च ।\nअविद्याकामकर्माणि लिङ्गं पुयेष्टकं विदुः",
    "verse_number": "44",
    "char_count": 86
  },
  {
    "chunk_id": "panchikaran_045",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "एतत्सूक्ष्मशरीरं स्यान्मायिकं प्रात्यगात्मनः ।\nकरणोपरमे जाग्रत्सङ्कारोत्थं प्रबोधवत्",
    "verse_number": "45",
    "char_count": 84
  },
  {
    "chunk_id": "panchikaran_046",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "ग्राह्यग्राहकरूपेण स्फुरणं स्वप्न उच्यते ।\nअभिमानी तयोर्यस्तु तैजसः परिकीर्तितः",
    "verse_number": "46",
    "char_count": 79
  },
  {
    "chunk_id": "panchikaran_047",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "हिरण्यगर्भरूपेण तैजसं चिन्तयेद् बुधः ।\nचैतन्याभासखचितं शरीरद्वयकारणम्",
    "verse_number": "47",
    "char_count": 69
  },
  {
    "chunk_id": "panchikaran_048",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "आत्माज्ञानं तदव्यक्तमव्याकृतमितीर्यते ।\nन सन्नासन्न सदसद्मिन्नाभिन्नं न चात्मनः",
    "verse_number": "48",
    "char_count": 79
  },
  {
    "chunk_id": "panchikaran_049",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "न सभागं न निर्भागं न चाप्युभयरूपकम् ।\nब्रह्मात्मैकत्वविज्ञानहेयं मिथ्यात्वकारणात्",
    "verse_number": "49",
    "char_count": 81
  },
  {
    "chunk_id": "panchikaran_050",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "ज्ञानानामुपसंहारो बुद्वेः करणतास्थितिः ।\nवटबीजे वटस्येव सुषुप्तिरभिधीयते",
    "verse_number": "50",
    "char_count": 72
  },
  {
    "chunk_id": "panchikaran_051",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अभिमानी तयोर्यस्तु प्राज्ञ इत्यभिधीयते ।\nजगत्कारणरूपेण प्राज्ञात्मानं विचिन्तयेत्",
    "verse_number": "51",
    "char_count": 81
  },
  {
    "chunk_id": "panchikaran_052",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "विश्वतैजससौषुप्त विराट् सूत्राक्षरात्मभिः ।\nविभिन्नमिव संमोहादेकं तत्त्वं चिदात्मकम्",
    "verse_number": "52",
    "char_count": 84
  },
  {
    "chunk_id": "panchikaran_053",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "विश्वादिकत्रयं यस्माद्वैराजादित्रयात्मकम् ।\nएकत्वेनैव सम्पश्येदन्याभावप्रसिद्धये",
    "verse_number": "53",
    "char_count": 80
  },
  {
    "chunk_id": "panchikaran_054",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "ॐकारमात्रमखिलं विश्वप्राज्ञादिलक्षणम् ।\nवाच्यवाचकताभेदाद्भेदेनानुपलाब्धितः",
    "verse_number": "54",
    "char_count": 74
  },
  {
    "chunk_id": "panchikaran_055",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अकारमात्रं विश्वः स्यादुकारस्तैजसः स्मृतः ।\nप्राज्ञो मकार इत्येवं परिपश्येत्क्रमेण तु",
    "verse_number": "55",
    "char_count": 85
  },
  {
    "chunk_id": "panchikaran_056",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "समाधिकालात्प्रगेवं विचिन्त्यातिप्रयत्नतः ।\nस्थूलसूक्ष्मक्रमात्सर्वं चिदात्मनि विलापयेत्",
    "verse_number": "56",
    "char_count": 87
  },
  {
    "chunk_id": "panchikaran_057",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अकारं पुरूषं विश्वमुकारे प्रविलापयेत् ।\nउकारं तैजसं सूक्ष्मं मकारे प्रविलापयेत्",
    "verse_number": "57",
    "char_count": 79
  },
  {
    "chunk_id": "panchikaran_058",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "मकारं करणं प्राज्ञं चिदात्मनि विलापयेत् ।\nचिदात्माऽहं नित्यशुद्धबुद्धमुक्तसदद्वयः",
    "verse_number": "58",
    "char_count": 81
  },
  {
    "chunk_id": "panchikaran_059",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "परमानन्दसन्दोहवासुदेवोऽहमोमिति ।\nज्ञात्वा विवेचकं चित्तं तत्साक्षिणि विलापयेत्",
    "verse_number": "59",
    "char_count": 78
  },
  {
    "chunk_id": "panchikaran_060",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "चिदात्मनि विलीनं चेत्तच्चित्तं नैव चालयेत् ।\nपूर्णबोधात्मनाऽसीत पूर्णाचलसमुद्रवत्",
    "verse_number": "60",
    "char_count": 81
  },
  {
    "chunk_id": "panchikaran_061",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "एवं समाहितो योगी श्रद्धभक्तिसमन्वितः ।\nजितेन्द्रियो जितक्रोधः पश्येदात्मानमद्वयम्",
    "verse_number": "61",
    "char_count": 81
  },
  {
    "chunk_id": "panchikaran_062",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "आदिमध्यावसानेषु दुःखं सर्वमिदं यतः ।\nतस्मात्सर्वं परित्यज्य तत्त्वनिष्ठो भवेत्सदा",
    "verse_number": "62",
    "char_count": 81
  },
  {
    "chunk_id": "panchikaran_063",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "यः पश्येत्सर्वगं शान्तमानन्दात्मानमद्वयम् ।\nन तेन किंचिदाप्तत्यं ज्ञातव्यं वावशिष्यते",
    "verse_number": "63",
    "char_count": 85
  },
  {
    "chunk_id": "panchikaran_064",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कृतकृत्यो भवेद्विद्वाञ्जीवन्मुक्तो भवेत्सदा ।\nआत्मन्येवारूढभावो जगदेतन्न वीक्षते",
    "verse_number": "64",
    "char_count": 80
  },
  {
    "chunk_id": "panchikaran_065",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कदाचिदव्यवहारे तु द्वैतं यद्यपि पश्यति ।\nबोधात्मव्यतिरेकेण न पश्यति चिदन्वयात्",
    "verse_number": "65",
    "char_count": 78
  },
  {
    "chunk_id": "panchikaran_066",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "किन्तु पश्यति मिथयैव दिङ् मोहेन्दुविभागवत् ।\nप्रतिभासः शरीरस्य तदाऽप्रारब्धसङ्क्षयात्",
    "verse_number": "66",
    "char_count": 85
  },
  {
    "chunk_id": "panchikaran_067",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तस्य तावदेव चिरमित्यादि श्रुतिरब्रवीत् ।\nप्रारब्धस्यानुवृत्तिस्तु मुक्तस्याभासमात्रतः",
    "verse_number": "67",
    "char_count": 85
  },
  {
    "chunk_id": "panchikaran_068",
    "text_name": "panchikaran",
    "text_title_devanagari": "पञ्चीकरणम्",
    "category": "prakarana",
