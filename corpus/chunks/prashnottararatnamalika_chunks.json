[
  {
    "chunk_id": "prashnottararatnamalika_001",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कः खलु नालङ्क्रियते दृष्टादृष्टार्थसाधनपटीयान् ।\nअमुया कण्ठस्थितया प्रश्नोत्तररत्नमालिकया",
    "verse_number": "1",
    "char_count": 89
  },
  {
    "chunk_id": "prashnottararatnamalika_002",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "भगवन् किमुपादेयं गुरुवचनं हेयमपि किमकार्यम् ।\nको गुरुः अधिगततत्त्वः शिष्यहितायोद्यतः सततम्",
    "verse_number": "2",
    "char_count": 90
  },
  {
    "chunk_id": "prashnottararatnamalika_003",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "त्वरितं किं कर्तव्यं विदुषां संसारसन्ततिच्छेदः ।\nकिं मोक्षतरोर्बीजं सम्यक्ज्ञानं क्रियासिद्धम्",
    "verse_number": "3",
    "char_count": 94
  },
  {
    "chunk_id": "prashnottararatnamalika_004",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कः पथ्यतरो धर्मः कः शुचिरिह यस्य मानसं शुद्धम् ।\nकः पण्डितो विवेकी किं विषमवधीरणा गुरुषु",
    "verse_number": "4",
    "char_count": 88
  },
  {
    "chunk_id": "prashnottararatnamalika_005",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "किं संसारे सारं बहुशोऽपि विचिन्त्यमानमिदमेव ।\nकिं मनुजेष्विष्टतमं स्वपरहितायोद्यतं जन्म",
    "verse_number": "5",
    "char_count": 87
  },
  {
    "chunk_id": "prashnottararatnamalika_006",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "मदिरेव मोहजनकः कः स्नेहः के च दस्यवो विषयाः ।\nका भववल्लि तृष्णा को वैरी यस्त्वनुद्योगः",
    "verse_number": "6",
    "char_count": 86
  },
  {
    "chunk_id": "prashnottararatnamalika_007",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कस्माद्भयमिह मरणादन्धादिह को विशिष्यते रागी ।\nकः शूरो यो ललनालोचनबाणैर्न च व्यधितः",
    "verse_number": "7",
    "char_count": 82
  },
  {
    "chunk_id": "prashnottararatnamalika_008",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "पान्तुं कर्णाञ्जलिभिः किममृतमिह युज्यते सदुपदेशः ।\nकिं गुरुताया मूलं यदेतदप्रार्थनं नाम",
    "verse_number": "8",
    "char_count": 87
  },
  {
    "chunk_id": "prashnottararatnamalika_009",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "किं गहनं स्त्रीचरितं कश्चतुरो यो न खण्डितस्तेन ।\nकिं दुःखं असन्तोषः किं लाघवमधमतो याच्ञा",
    "verse_number": "9",
    "char_count": 88
  },
  {
    "chunk_id": "prashnottararatnamalika_010",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "किं जीवितमनवद्यं किं जाड्यं पाठतोऽप्यनभ्यासः ।\nको जागर्ति विवेकी को निद्रा मूढता जन्तोः",
    "verse_number": "10",
    "char_count": 87
  },
  {
    "chunk_id": "prashnottararatnamalika_011",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "नलिनीदलगतजलवत्तरलं किं यौवनं धनं चायुः ।\nकथय पुनः के शशिनः किरणसमाः सज्जना एव",
    "verse_number": "11",
    "char_count": 77
  },
  {
    "chunk_id": "prashnottararatnamalika_012",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "को नरकः परवशता किं सौख्यं सर्वसङ्गविरतिर्या ।\nकिं सत्यं भूतहितं प्रियं च किं प्राणिनामसवः",
    "verse_number": "12",
    "char_count": 89
  },
  {
    "chunk_id": "prashnottararatnamalika_013",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कोऽनर्थफलो मानः का सुखदा साधुजनमैत्री ।\nसर्वव्यसनविनाशे को दक्षः सर्वथा त्यागी",
    "verse_number": "13",
    "char_count": 78
  },
  {
    "chunk_id": "prashnottararatnamalika_014",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "किं मरणं मूर्खत्वं किं चानर्घं यदवसरे दत्तम् ।\nआमरणात् किं शल्यं प्रच्छन्नं यत्कृतं पापम्",
    "verse_number": "14",
    "char_count": 89
  },
  {
    "chunk_id": "prashnottararatnamalika_015",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कुत्र विधेयो यत्नो विद्याभ्यासे सदौषधे दाने ।\nअवधीरणा क्व कार्या खलपरयोषित्परधनेषु",
    "verse_number": "15",
    "char_count": 82
  },
  {
    "chunk_id": "prashnottararatnamalika_016",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "काहर्निशमनुचिन्त्या संसारासारता न तु प्रमदा ।\nका प्रेयसी विधेया करणा दीनेषु सज्जने मैत्री",
    "verse_number": "16",
    "char_count": 89
  },
  {
    "chunk_id": "prashnottararatnamalika_017",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कण्ठगतैरप्यसुभिः कस्य ह्यात्मा न शक्यते जेतुम् ।\nमूर्खस्य शङ्कितस्य च विषादिनो वा कृतघ्नस्य",
    "verse_number": "17",
    "char_count": 91
  },
  {
    "chunk_id": "prashnottararatnamalika_018",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कः साधुः सदवृत्तः कमधममाचक्षते त्वसद्वृत्तम् ।\nकेन जितं जगदेतत्सत्यतितिक्षावता पुंसा",
    "verse_number": "18",
    "char_count": 84
  },
  {
    "chunk_id": "prashnottararatnamalika_019",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कस्मै नमांसि देवाः कुर्वन्ति दयाप्रधानाय ।\nकस्मादुद्वेगः स्यात्संसारारण्यतः सुधियः",
    "verse_number": "19",
    "char_count": 82
  },
  {
    "chunk_id": "prashnottararatnamalika_020",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कस्य वशे प्राणिगणः सत्यप्रियभाषिणो विनीतस्य ।\nक्व स्थातव्यं न्याय्ये पथि दृष्टादृष्टलाभाढ्ये",
    "verse_number": "20",
    "char_count": 92
  },
  {
    "chunk_id": "prashnottararatnamalika_021",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कोऽन्धो योऽकर्यरतः को बधिरो यो हितानि न शृणोति ।\nको मूको यः काले प्रियाणि वक्तुं न जानाति",
    "verse_number": "21",
    "char_count": 89
  },
  {
    "chunk_id": "prashnottararatnamalika_022",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "किं दानमनाकाङ्क्षं किं मित्रं यो निवारयति पापात् ।\nकोऽलङ्कारः शीलं किं वाचां मण्डनं सत्यम्",
    "verse_number": "22",
    "char_count": 90
  },
  {
    "chunk_id": "prashnottararatnamalika_023",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "विद्युद्विलसितचपलं किं दुर्जनसङ्गतिर्युवतयश्च ।\nकुलशीलनिष्प्रकम्पाः के कलिकालेऽपि सज्जना एव",
    "verse_number": "23",
    "char_count": 91
  },
  {
    "chunk_id": "prashnottararatnamalika_024",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "चिन्तामणिरिव दुर्लभमिह किं कथयामि तच्चतुर्भद्रम् ।\nकिं तद्वदन्ति भूयो विधुततमसा विशेषेण",
    "verse_number": "24",
    "char_count": 87
  },
  {
    "chunk_id": "prashnottararatnamalika_025",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "दानं प्रियवाक्सहितं ज्ञानमगर्वं क्षमान्वितं शौर्यम् ।\nवित्तं त्यागसमेतं दुर्लभमेतच्चतुर्भद्रम्",
    "verse_number": "25",
    "char_count": 94
  },
  {
    "chunk_id": "prashnottararatnamalika_026",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "किं शोच्यं कार्पण्यं सति विभवे किं प्रशस्तमौदार्यम् ।\nकः पूज्यो विद्वद्भिः स्वभावतः सर्वदा विनीतो यः",
    "verse_number": "26",
    "char_count": 100
  },
  {
    "chunk_id": "prashnottararatnamalika_027",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कः कुलकमलदिनेशः सति गुणाविभवेऽपि यो नम्रः ।\nकस्य वशे जगदेतत्प्रियहितवचनस्यधर्मनिरतस्य",
    "verse_number": "27",
    "char_count": 85
  },
  {
    "chunk_id": "prashnottararatnamalika_028",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "विद्वन्मनोहरा का सत्कविता बोधवनिता च ।\nकं न स्पृशति विपत्तिः प्रवृद्धवचनानुवर्तिनं दान्तम्",
    "verse_number": "28",
    "char_count": 90
  },
  {
    "chunk_id": "prashnottararatnamalika_029",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कस्मै स्पृहयति कमला त्वनलसचित्ताय नीतिवृत्ताय ।\nत्यजति च कं सहसा द्विजगुरुसुरनिन्दाकरं च सालस्यम्",
    "verse_number": "29",
    "char_count": 97
  },
  {
    "chunk_id": "prashnottararatnamalika_030",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कुत्र विधेयो वासः सज्जननिकटेऽथवा काश्याम् ।\nकः परिहार्यो देशः पिशुनयुतो लुब्धभूपश्च",
    "verse_number": "30",
    "char_count": 83
  },
  {
    "chunk_id": "prashnottararatnamalika_031",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "केनाशोच्यः पुरुषः प्रणतकलत्रेण धीरविभवेन ।\nइह भुवने कः शोच्यः सत्यपि विभवे न यो दाता",
    "verse_number": "31",
    "char_count": 84
  },
  {
    "chunk_id": "prashnottararatnamalika_032",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "किं लघुताया मूलं प्राकृतपुरुषेषु या याच्ञा ।\nरामादपि कः शूरः स्मरशरनिहतो न यश्चलति",
    "verse_number": "32",
    "char_count": 82
  },
  {
    "chunk_id": "prashnottararatnamalika_033",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "किमहर्निशमनुचिन्त्यं भगवच्चरणं न संसारः ।\nचक्षुष्मन्तोऽप्यन्धाः के स्युः ये नास्तिका मनुजाः",
    "verse_number": "33",
    "char_count": 91
  },
  {
    "chunk_id": "prashnottararatnamalika_034",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कः पङ्गुरिह प्रथितो व्रजति च यो वार्द्धके तीर्थम् ।\nकिं तीर्थमपि च मुख्यं चित्तमलं यन्निवर्तयति",
    "verse_number": "34",
    "char_count": 95
  },
  {
    "chunk_id": "prashnottararatnamalika_035",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "किं स्मर्त्तव्यं पुरुषैः हरिनाम सदा न यावनी भाषा ।\nको हि न वाच्यः सुधिया परदोषश्चानृतं तद्वत्",
    "verse_number": "35",
    "char_count": 93
  },
  {
    "chunk_id": "prashnottararatnamalika_036",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "किं सम्पाद्यं मनुजैः विद्या वित्तं बलं यशः पुण्यम् ।\nकः सर्वगुणविनाशी लोभः शत्रुश्च कः कामः",
    "verse_number": "36",
    "char_count": 91
  },
  {
    "chunk_id": "prashnottararatnamalika_037",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "का च सभा परिहार्या हीना या वृद्धसचिवेन ।\nइह कुत्रावहितः स्यान्मनुजः किल राजसेवायाम्",
    "verse_number": "37",
    "char_count": 83
  },
  {
    "chunk_id": "prashnottararatnamalika_038",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "प्राणादपि को रम्यः कुलधर्मः साधुसङ्गश्च ।\nका संरक्ष्या कीर्तिः पतिव्रता नैजबुद्धिश्च",
    "verse_number": "38",
    "char_count": 84
  },
  {
    "chunk_id": "prashnottararatnamalika_039",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "का कल्पलता लोके सच्छिष्यायार्पिता विद्या ।\nकोऽक्षयवटवृक्षः स्यात्विधिवत्सत्पात्रदत्तदानं यत्",
    "verse_number": "39",
    "char_count": 92
  },
  {
    "chunk_id": "prashnottararatnamalika_040",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "किं शस्त्रं सर्वेषां युक्तिः माता च का धेनुः ।\nकिं नु बलं यद्धैर्यं को मृत्युः यदवधानरहितत्वम्",
    "verse_number": "40",
    "char_count": 94
  },
  {
    "chunk_id": "prashnottararatnamalika_041",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कुत्र विषं दुष्टजने किमिहाशौचं भवेतृणं नृणाम् ।\nकिमभयमिह वैराम्यं भयमपि किं वित्तमेव सर्वेषाम्",
    "verse_number": "41",
    "char_count": 94
  },
  {
    "chunk_id": "prashnottararatnamalika_042",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "का दुर्लभा नराणां हरिभक्तिः पातकं च किं हिंसा ।\nको हि भगवत्प्रियः स्यात्योऽन्यं नोद्वेजयेदनुद्विग्नः",
    "verse_number": "42",
    "char_count": 100
  },
  {
    "chunk_id": "prashnottararatnamalika_043",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कस्मात् सिद्धिः तपसः बुद्धिः क्व नु भूसुरे कुतो बुद्धिः ।\nवृद्धोपसेवया के वृद्धा ये धर्मतत्त्वज्ञाः",
    "verse_number": "43",
    "char_count": 99
  },
  {
    "chunk_id": "prashnottararatnamalika_044",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सम्भावितस्य मरणादधिकं किं दुर्यशो भवति ।\nलोके सुखी भवेत्को धनवान्धनमपि च किं यतश्चेष्टम्",
    "verse_number": "44",
    "char_count": 88
  },
  {
    "chunk_id": "prashnottararatnamalika_045",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सर्वसुखानां बीजं किं पुण्यं दुःखमपि कुतः पापात् ।\nकस्यैश्वर्यं यः किल शङ्करमाराधयेद्भक्त्या",
    "verse_number": "45",
    "char_count": 91
  },
  {
    "chunk_id": "prashnottararatnamalika_046",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "को वर्द्धते विनीतः को वा हीयेत यो दृप्तः ।\nको न प्रत्येतव्यो ब्रूते यश्चानृतं शश्वत्",
    "verse_number": "46",
    "char_count": 84
  },
  {
    "chunk_id": "prashnottararatnamalika_047",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कुत्रानृतेऽप्यपापां यच्चोक्तं धर्मरक्षार्थम् ।\nको धर्मोऽभिमतो यः शिष्टानां निजकुलीनानाम्",
    "verse_number": "47",
    "char_count": 88
  },
  {
    "chunk_id": "prashnottararatnamalika_048",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "साधुबलं किं दैवं कः साधुः सर्वदा तुष्टः ।\nदैवं किं यत्सुकृतं कः सुकृती श्लाघ्यते च यः सद्भिः",
    "verse_number": "48",
    "char_count": 92
  },
  {
    "chunk_id": "prashnottararatnamalika_049",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "गृहमेधिनश्च मित्रं किं भार्या को गृही च यो यजते ।\nको यज्ञो यः श्रुत्या विहितः श्रेयस्करो नृणाम्",
    "verse_number": "49",
    "char_count": 95
  },
  {
    "chunk_id": "prashnottararatnamalika_050",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कस्य क्रिया हि सफला यः पुनराचारवां शिष्टः ।\nकः शिष्टो यो वेदप्रमाणवां को हतः क्रियाभ्रष्टः",
    "verse_number": "50",
    "char_count": 90
  },
  {
    "chunk_id": "prashnottararatnamalika_051",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "को धन्यः संन्यासी को मान्यः पण्डितः साधुः ।\nकः सेव्यो यो दाता को दाता योऽर्थितृप्तिमातनुते",
    "verse_number": "51",
    "char_count": 90
  },
  {
    "chunk_id": "prashnottararatnamalika_052",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "किं भाग्यं देहवतामारोग्यं कः फली कृषिकृत् ।\nकस्य न पापं जपतः कः पूर्णो यः प्रजावां स्यात्",
    "verse_number": "52",
    "char_count": 89
  },
  {
    "chunk_id": "prashnottararatnamalika_053",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "किं दुष्करं नराणां यन्मनसो निग्रहः सततम् ।\nको ब्रह्मचर्यवां स्यात्यश्चास्खलितोर्ध्वरेतस्कः",
    "verse_number": "53",
    "char_count": 90
  },
  {
    "chunk_id": "prashnottararatnamalika_054",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "का च परदेवतोक्ता चिच्छक्तिः को जगत्भर्ता ।\nसूर्यः सर्वेषां को जीवनहेतुः स पर्जन्यः",
    "verse_number": "54",
    "char_count": 82
  },
  {
    "chunk_id": "prashnottararatnamalika_055",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कः शुरो यो भीतत्राता त्राता च कः सद्गुरुः ।\nको हि जगद्गुरुरुक्तः शम्भुः ज्ञानं कुतः शिवादेव",
    "verse_number": "55",
    "char_count": 91
  },
  {
    "chunk_id": "prashnottararatnamalika_056",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "मुक्तिं लभेत कस्मान्मुकुन्दभक्तेः मुकुन्दः कः ।\nयस्तारयेदविद्यां का चाविद्या यदात्मनोऽस्फूर्तिः",
    "verse_number": "56",
    "char_count": 95
  },
  {
    "chunk_id": "prashnottararatnamalika_057",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कस्य न शोको यः स्याद्क्रोधः किं सुखं तुष्टिः ।\nको राजा रञ्चनकृत्कश्च श्वा नीचसेवको यः स्यात्",
    "verse_number": "57",
    "char_count": 92
  },
  {
    "chunk_id": "prashnottararatnamalika_058",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "को मायी परमेशः क इन्द्रजालायते प्रपञ्चोऽयम् ।\nकः स्वप्ननिभो जाग्रद्व्यवहारः सत्यमपि च किं ब्रह्म",
    "verse_number": "58",
    "char_count": 96
  },
  {
    "chunk_id": "prashnottararatnamalika_059",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "किं मिथ्या यद्विद्यानाश्यं तुच्छं तु शशविषाणादि ।\nका चानिर्वाच्या माया किं कल्पितं द्वैतम्",
    "verse_number": "59",
    "char_count": 90
  },
  {
    "chunk_id": "prashnottararatnamalika_060",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "किं पारमार्थिकं स्यादद्वैतं चाज्ञता कुतोऽनादिः ।\nवपुषश्च पोषकं किं प्रारब्धं चान्नदायि किं चायुः",
    "verse_number": "60",
    "char_count": 96
  },
  {
    "chunk_id": "prashnottararatnamalika_061",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "को ब्रह्मणैरुपास्यो गायत्र्यर्काग्निगोचरः शम्भुः ।\nगायत्र्यामादित्ये चाग्नौ शम्भ च किं नु तत्तत्त्वम्",
    "verse_number": "61",
    "char_count": 101
  },
  {
    "chunk_id": "prashnottararatnamalika_062",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "प्रात्यक्षदेवता का माता पूज्यो गुरुश्च कः तातः ।\nकः सर्वदेवतात्मा विद्याकर्मान्वितो विप्रः",
    "verse_number": "62",
    "char_count": 90
  },
  {
    "chunk_id": "prashnottararatnamalika_063",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कश्च कुलक्षयहेतुः सन्तापः सज्जनेषु योऽकारि ।\nकेषाममोघ वचनं ये च पुनः सत्यमौनशमशीलाः",
    "verse_number": "63",
    "char_count": 83
  },
  {
    "chunk_id": "prashnottararatnamalika_064",
    "text_name": "prashnottararatnamalika",
    "text_title_devanagari": "प्रश्नोत्तररत्नमालिका",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "किं जन्म विषयसङ्गः किमुत्तरं जन्म पुत्रः स्यात् ।\nकोऽपरिहार्यो मृत्युः कुत्र पदं विन्यसेच्च दृक्पूते",
    "verse_number": "64",
    "char_count": 100
