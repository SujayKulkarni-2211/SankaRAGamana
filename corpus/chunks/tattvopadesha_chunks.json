[
  {
    "chunk_id": "tattvopadesha_001",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तत्त्वंपदार्थशुद्ध्यर्थं गुरुः शिष्यं वचोऽब्रवीत् ।\nवाक्ये तत्त्वमसीत्यत्र त्वम्पदार्थं विवेचय",
    "verse_number": "1",
    "char_count": 94
  },
  {
    "chunk_id": "tattvopadesha_002",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "न त्वं देहोऽसि दृश्यत्वादुपजात्यादिमत्त्वतः ।\nभौतिकत्वादशुद्धत्वादनित्यत्त्वात्तथैव च",
    "verse_number": "2",
    "char_count": 85
  },
  {
    "chunk_id": "tattvopadesha_003",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अदृश्यो रूपहीनस्त्वं जातिहीनोऽप्यभौतिकः ।\nशुद्धनित्योऽसि दृग्रूपो घटो यद्वन्न दृग्भवेत्",
    "verse_number": "3",
    "char_count": 87
  },
  {
    "chunk_id": "tattvopadesha_004",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "न भवानिन्द्रियाण्येषां करणत्वेन या श्रुतिः ।\nप्रेरकस्त्वं पृथक्तेभ्यो न कर्ता करणं भवेत्",
    "verse_number": "4",
    "char_count": 88
  },
  {
    "chunk_id": "tattvopadesha_005",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "नानैतान्येकरूपस्त्वं भिन्नस्तेभ्यः कुतः शृणु ।\nन चैकेन्द्रियरूपस्त्वं सर्वत्राहम्प्रतीतितः",
    "verse_number": "5",
    "char_count": 90
  },
  {
    "chunk_id": "tattvopadesha_006",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "न तेषां समुदायोऽसि तेषामन्यतमस्य च ।\nविनाशेऽप्यात्मधीस्तावदस्ति स्यान्नैवमन्यथा",
    "verse_number": "6",
    "char_count": 79
  },
  {
    "chunk_id": "tattvopadesha_007",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "प्रत्येकमपि तान्यात्मा नैव तत्र नयं शृणु ।\nनानास्वामिकदेहोऽयं नश्येद्भिन्नमताश्रयः",
    "verse_number": "7",
    "char_count": 82
  },
  {
    "chunk_id": "tattvopadesha_008",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "नानात्माभिमतं नैव विरुद्धविषयत्वतः ।\nस्वाम्यैक्ये तु व्यवस्था स्यादेकपार्थिवदेशवत्",
    "verse_number": "8",
    "char_count": 82
  },
  {
    "chunk_id": "tattvopadesha_009",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "न मनस्त्वं न वा प्राणो जडत्वादेव चैतयोः ।\nगतमन्यत्र मे चित्तमित्यन्यत्वानुभूतितः",
    "verse_number": "9",
    "char_count": 80
  },
  {
    "chunk_id": "tattvopadesha_010",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "क्षुत्तृड्भ्यां पीडितः प्राणो ममायं चेति भेदतः ।\nतयोर्द्रष्टा पृथक्ताभ्यां घटद्रष्टा घटाद्यथा",
    "verse_number": "10",
    "char_count": 93
  },
  {
    "chunk_id": "tattvopadesha_011",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सुप्तौ लीनास्ति या बोधे सर्वं व्याप्नोति देहकम् ।\nचिच्छायया च सम्बद्धा न सा बुद्धिर्भवान्द्विज",
    "verse_number": "11",
    "char_count": 94
  },
  {
    "chunk_id": "tattvopadesha_012",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "नानारूपवती बोधे सुप्तौ लीनातिचञ्चला ।\nयतो दृगेकरूपस्त्वं पृथक्तस्य प्रकाशकः",
    "verse_number": "12",
    "char_count": 75
  },
  {
    "chunk_id": "tattvopadesha_013",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सुप्तौ देहाद्यभावेऽपि साक्षी तेषां भवान्यतः ।\nस्वानुभूतिस्वरूपत्वान्नान्यस्तस्यास्ति भासकः",
    "verse_number": "13",
    "char_count": 90
  },
  {
    "chunk_id": "tattvopadesha_014",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "प्रमाणं बोधयन्तं तं बोधं मानेन ये जनाः ।\nबुभुत्स्यन्ते त एधोभिर्दग्धुं वाञ्छन्ति पावकम्",
    "verse_number": "14",
    "char_count": 87
  },
  {
    "chunk_id": "tattvopadesha_015",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "विश्वमात्मानुभवति तेनासौ नानुभूयते ।\nविश्वं प्रकाशयत्यात्मा तेनासौ न प्रकाश्यते",
    "verse_number": "15",
    "char_count": 79
  },
  {
    "chunk_id": "tattvopadesha_016",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "ईदृशं तादृशं नैतन्न परोक्षं सदेव यत् ।\nतद्ब्रह्म त्वं न देहादिदृश्यरूपोऽसि सर्वदृक्",
    "verse_number": "16",
    "char_count": 83
  },
  {
    "chunk_id": "tattvopadesha_017",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "इदंत्वेनैव यद्भाति सर्वं तच्च निषिध्यते ।\nअवाच्यतत्त्वमनिदं न वेद्यं स्वप्रकाशतः",
    "verse_number": "17",
    "char_count": 80
  },
  {
    "chunk_id": "tattvopadesha_018",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सत्यं ज्ञानमनन्तं च ब्रह्मलक्षणमुच्यते ।\nसत्यत्वाज्ज्ञानरूपत्वादनन्तत्वात्त्वमेव हि",
    "verse_number": "18",
    "char_count": 83
  },
  {
    "chunk_id": "tattvopadesha_019",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सति देहाद्युपाधौ स्याज्जीवस्तस्य नियामकः ।\nईश्वरः शक्त्युपाधित्वाद्द्वयोर्बाधे स्वयम्प्रभः",
    "verse_number": "19",
    "char_count": 90
  },
  {
    "chunk_id": "tattvopadesha_020",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अपेक्ष्यतेऽखिलैर्मानैर्न यन्मानमपेक्षते ।\nवेदवाक्यं प्रमाणं तद्ब्रह्मात्मावगतौ मतम्",
    "verse_number": "20",
    "char_count": 83
  },
  {
    "chunk_id": "tattvopadesha_021",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अतो हि तत्त्वमस्यादिवेदवाक्यं प्रमाणतः ।\nब्रह्मणोऽस्ति यया युक्त्या सास्माभिः सम्प्रकीर्त्यते",
    "verse_number": "21",
    "char_count": 93
  },
  {
    "chunk_id": "tattvopadesha_022",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "शोधिते त्वम्पदार्थे हि तत्त्वमस्यादि चिन्तितम् ।\nसम्भवेन्नान्यथा तस्माच्छोधनं कृतमादितः",
    "verse_number": "22",
    "char_count": 87
  },
  {
    "chunk_id": "tattvopadesha_023",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "देहेन्द्रियादिधर्मान्यः स्वात्मन्यारोपयन्मृषा ।\nकर्तृत्वाद्यभिमानी च वाच्यार्थस्त्वंपदस्य सः",
    "verse_number": "23",
    "char_count": 92
  },
  {
    "chunk_id": "tattvopadesha_024",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "देहेन्द्रियादिसाक्षी यस्तेभ्यो भाति विलक्षणः ।\nस्वयं बोधस्वरूपत्वाल्लक्ष्यार्थस्त्वंपदस्य सः",
    "verse_number": "24",
    "char_count": 92
  },
  {
    "chunk_id": "tattvopadesha_025",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "वेदान्तवाक्यसंवेद्यविश्वातीताक्षराद्वयम् ।\nविशुद्धं यत्स्वसंवेद्यं लक्ष्यार्थस्तत्पदस्य सः",
    "verse_number": "25",
    "char_count": 90
  },
  {
    "chunk_id": "tattvopadesha_026",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सामानाधिकरण्यं हि पदयोस्तत्त्वमोर्द्वयोः ।\nसम्बन्धस्तेन वेदान्तैर्ब्रह्मैक्यं प्रतिपाद्यते",
    "verse_number": "26",
    "char_count": 90
  },
  {
    "chunk_id": "tattvopadesha_027",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "भिन्नप्रवृत्तिहेतुत्वे पदयोरेकवस्तुनि ।\nवृत्तित्वं यत्तथैवैक्यं विभक्त्यन्तकयोस्तयोः",
    "verse_number": "27",
    "char_count": 84
  },
  {
    "chunk_id": "tattvopadesha_028",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सामानाधिकरण्यं तत्सम्प्रदायिभिरीरितम् ।\nतथा पदार्थयोरेव विशेषणविशेष्यता",
    "verse_number": "28",
    "char_count": 71
  },
  {
    "chunk_id": "tattvopadesha_029",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अयं सः सोऽयमितिवत्सम्बन्धो भवति द्वयोः ।\nप्रत्यक्त्वं सद्वितीयत्वं परोक्षत्वं च पूर्णता",
    "verse_number": "29",
    "char_count": 87
  },
  {
    "chunk_id": "tattvopadesha_030",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "परस्परविरुद्धं स्यात्ततो भवति लक्षणा ।\nलक्ष्यलक्षणसम्बन्धः पदार्थप्रत्यगात्मनोः",
    "verse_number": "30",
    "char_count": 79
  },
  {
    "chunk_id": "tattvopadesha_031",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "मानान्तरोपरोधाच्च मुख्यार्थस्यापरिग्रहे ।\nमुख्यार्थस्याविनाभूते प्रवृत्तिर्लक्षणोच्यते",
    "verse_number": "31",
    "char_count": 86
  },
  {
    "chunk_id": "tattvopadesha_032",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "त्रिविधा लक्षणा ज्ञेया जहत्यजहती तथा ।\nअन्योभयात्मिका ज्ञेया तत्राद्या नैव सम्भवेत्",
    "verse_number": "32",
    "char_count": 83
  },
  {
    "chunk_id": "tattvopadesha_033",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "वाच्यार्थमखिलं त्यक्त्वा वृत्तिः स्याद्या तदन्विते ।\nगङ्गायां घोष इतिवज्जहती लक्षणा हि सा",
    "verse_number": "33",
    "char_count": 89
  },
  {
    "chunk_id": "tattvopadesha_034",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "वाच्यार्थस्यैकदेशस्य प्रकृते त्याग इष्यते ।\nजहती सम्भवेन्नैव सम्प्रदायविरोधतः",
    "verse_number": "34",
    "char_count": 77
  },
  {
    "chunk_id": "tattvopadesha_035",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "वाच्यार्थमपरित्यज्य वृत्तिरन्यार्थके तु या ।\nकथितेयमजहती शोणोऽयं धावतीतिवत्",
    "verse_number": "35",
    "char_count": 75
  },
  {
    "chunk_id": "tattvopadesha_036",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "न सम्भवति साप्यत्र वाच्यार्थेऽतिविरोधतः ।\nविरोधांशपरित्यागो दृश्यते प्रकृते यतः",
    "verse_number": "36",
    "char_count": 79
  },
  {
    "chunk_id": "tattvopadesha_037",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "वाच्यार्थस्यैकदेशं च परित्यज्यैकदेशकम् ।\nया बोधयति सा ज्ञेया तृतीया भागलक्षणा",
    "verse_number": "37",
    "char_count": 77
  },
  {
    "chunk_id": "tattvopadesha_038",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सोऽयं विप्र इदं वाक्यं बोधयत्यादितस्तथा ।\nतत्कालत्वविशिष्टं च तथैतत्कालसंयुतम्",
    "verse_number": "38",
    "char_count": 78
  },
  {
    "chunk_id": "tattvopadesha_039",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अतस्तयोर्विरुद्धं तत्तत्कालत्वादिधर्मकम् ।\nत्यक्त्वा वाक्यं यथा विप्रपिण्डं बोधयतीरितम्",
    "verse_number": "39",
    "char_count": 87
  },
  {
    "chunk_id": "tattvopadesha_040",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तथैव प्रकृते तत्त्वमसीत्यत्र श्रुतौ शृणु ।\nप्रत्यक्त्वादीन्परित्यज्य जीवधर्मांस्त्वमःपदात्",
    "verse_number": "40",
    "char_count": 90
  },
  {
    "chunk_id": "tattvopadesha_041",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सर्वज्ञत्वपरोक्षादीन्परित्यज्य ततःपदात् ।\nशुद्धं कूटस्थमद्वैतं बोधयत्यादरात्परम्",
    "verse_number": "41",
    "char_count": 80
  },
  {
    "chunk_id": "tattvopadesha_042",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तत्त्वमोः पदयोरैक्यमेव तत्त्वमसीत्यलम् ।\nइत्थमैक्यावबोधेन सम्यग्ज्ञानं दृढं नयैः",
    "verse_number": "42",
    "char_count": 80
  },
  {
    "chunk_id": "tattvopadesha_043",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अहं ब्रह्मेति विज्ञानं यस्य शोकं तरत्यसौ ।\nआत्मा प्रकाशमानोऽपि महावाक्यैस्तथैकता",
    "verse_number": "43",
    "char_count": 80
  },
  {
    "chunk_id": "tattvopadesha_044",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तत्त्वमोर्बोध्यतेऽथापि पौर्वापर्यानुसारतः ।\nतथापि शक्यते नैव श्रीगुरोः करुणां विना",
    "verse_number": "44",
    "char_count": 82
  },
  {
    "chunk_id": "tattvopadesha_045",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अपरोक्षयितुं लोके मूढैः पण्डितमानिभिः ।\nअन्तःकरणसंशुद्धौ स्वयं ज्ञानं प्रकाशते",
    "verse_number": "45",
    "char_count": 78
  },
  {
    "chunk_id": "tattvopadesha_046",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "वेदवाक्यैरतः किं स्याद्गुरुणेति न साम्प्रतम् ।\nआचार्यवान्पुरुषो हि वेदेत्येवं श्रुतिर्जगौ",
    "verse_number": "46",
    "char_count": 89
  },
  {
    "chunk_id": "tattvopadesha_047",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अनादाविह संसारे बोधको गुरुरेव हि ।\nअतो ब्रह्मात्मवस्त्वैक्यं ज्ञात्वा दृश्यमसत्तया",
    "verse_number": "47",
    "char_count": 82
  },
  {
    "chunk_id": "tattvopadesha_048",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अद्वैते ब्रह्मणि स्थेयं प्रत्यग्ब्रह्मात्मना सदा ।\nतत्प्रत्यक्षात्परिज्ञातमद्वैतब्रह्मचिद्घनम्",
    "verse_number": "48",
    "char_count": 94
  },
  {
    "chunk_id": "tattvopadesha_049",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "प्रतिपाद्यं तदेवात्र वेदान्तैर्न द्वयं जडम् ।\nसुखरूपं चिदद्वैतं दुःखरूपमसज्जडम्",
    "verse_number": "49",
    "char_count": 79
  },
  {
    "chunk_id": "tattvopadesha_050",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "वेदान्तैस्तद्द्वयं सम्यङ्निर्णीतं वस्तुतो नयात् ।\nअद्वैतमेव सत्यं त्वं विद्धि द्वैतमसत्सदा",
    "verse_number": "50",
    "char_count": 90
  },
  {
    "chunk_id": "tattvopadesha_051",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "शुद्धे कथमशुद्धः स्याद्।ह्दृश्यं मायामयं ततः ।\nशुक्तौ रूप्यं मृषा यद्वत्तथा विश्वं परात्मनि",
    "verse_number": "51",
    "char_count": 91
  },
  {
    "chunk_id": "tattvopadesha_052",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "विद्यते न स्वतः सत्त्वं नासतः सत्त्वमस्ति वा ।\nबाध्यत्वान्नैव सद्द्वैतं नासत्प्रत्यक्षभानतः",
    "verse_number": "52",
    "char_count": 91
  },
  {
    "chunk_id": "tattvopadesha_053",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सदसन्न विरुद्धत्वादतोऽनिर्वाच्यमेव तत् ।\nयः पूर्वमेक एवासीत्सृष्ट्वा पश्चादिदं जगत्",
    "verse_number": "53",
    "char_count": 83
  },
  {
    "chunk_id": "tattvopadesha_054",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "प्रविष्टो जीवरूपेण स एवात्मा भवान्परः ।\nसच्चिदानन्द एव त्वं विस्मृत्यात्मतया परम्",
    "verse_number": "54",
    "char_count": 81
  },
  {
    "chunk_id": "tattvopadesha_055",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "जीवभावमनुप्राप्तः स एवात्मासि बोधतः ।\nअद्वयानन्दचिन्मात्रः शुद्धः साम्राज्यमागतः",
    "verse_number": "55",
    "char_count": 80
  },
  {
    "chunk_id": "tattvopadesha_056",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कर्तृत्वादीनि यान्यासंस्त्वयि ब्रह्माद्वये परे ।\nतानीदानीं विचार्य त्वं किंस्वरूपाणि वस्तुतः",
    "verse_number": "56",
    "char_count": 92
  },
  {
    "chunk_id": "tattvopadesha_057",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अत्रैव शृणु वृत्तान्तमपूर्वं श्रुतिभाषितम् ।\nकश्चिद्गान्धारदेशीयो महारत्नविभूषितः",
    "verse_number": "57",
    "char_count": 81
  },
  {
    "chunk_id": "tattvopadesha_058",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "स्वगृहे स्वाङ्गणे सुप्तः प्रमत्तः सन्कदाचन ।\nरात्रौ चौरः समागत्य भूषणानां प्रलोभितः",
    "verse_number": "58",
    "char_count": 83
  },
  {
    "chunk_id": "tattvopadesha_059",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "बद्ध्वा देशान्तरं चौरैर्नीतः सन्गहने वने ।\nभूषणान्यपहृत्यापि बद्धाक्षकरपादकः",
    "verse_number": "59",
    "char_count": 76
  },
  {
    "chunk_id": "tattvopadesha_060",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "निक्षिप्तो विपिनेऽतीव कुशकण्टकवृश्चिकैः ।\nव्यालव्याघ्रादिभिश्चैव सङ्कुले तरुसङ्कटे",
    "verse_number": "60",
    "char_count": 82
  },
  {
    "chunk_id": "tattvopadesha_061",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "व्यालादिदुष्टसत्वेभ्यो महारण्ये भयातुरः ।\nशिलाकण्टकदर्भाद्यैर्देहस्य प्रतिकूलकैः",
    "verse_number": "61",
    "char_count": 80
  },
  {
    "chunk_id": "tattvopadesha_062",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "क्रियमाणे विलुठने विशीर्णाङ्गोऽसमर्थकः ।\nक्षुत्तृडातपवाय्वग्न्यादिभिस्तप्तोऽतितापकैः",
    "verse_number": "62",
    "char_count": 84
  },
  {
    "chunk_id": "tattvopadesha_063",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "बन्धमुक्तौ तथा देशप्राप्तावेव सुदुःखधीः ।\nददृशे कंचिदाक्रोशन्नैकं तत्रैव तस्थिवान्",
    "verse_number": "63",
    "char_count": 82
  },
  {
    "chunk_id": "tattvopadesha_064",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तथा रागादिभिर्वर्गैः शत्रुभिर्दुःखदायिभिः ।\nचौरैर्देहाभिमानाद्यैः स्वानन्दधनहारिभिः",
    "verse_number": "64",
    "char_count": 83
  },
  {
    "chunk_id": "tattvopadesha_065",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "ब्रह्मानन्दे प्रमत्तः स्वाज्ञाननिद्रावशीकृतः ।\nबद्धस्त्वं बन्धनैर्भोगतृष्णाज्वरादिभिर्दृढम्",
    "verse_number": "65",
    "char_count": 91
  },
  {
    "chunk_id": "tattvopadesha_066",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अद्वयानन्दरूपात्त्वां प्रच्याव्यातीव धूर्तकैः ।\nदूरनीतोऽसि देहेषु संसारारण्यभूमिषु",
    "verse_number": "66",
    "char_count": 82
  },
  {
    "chunk_id": "tattvopadesha_067",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सर्वदुःखनिदानेषु शरीरादित्रयेषु च ।\nनानायोनिषु कर्मान्धवासनानिर्मितासु च",
    "verse_number": "67",
    "char_count": 72
  },
  {
    "chunk_id": "tattvopadesha_068",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "प्रवेशितोऽसि सृष्टोऽसि बद्धः स्वानन्ददृष्टितः ।\nअनादिकालमारभ्य दुःखं चानुभवन्सदा",
    "verse_number": "68",
    "char_count": 80
  },
  {
    "chunk_id": "tattvopadesha_069",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "जन्ममृत्युजरादोषनरकादिपरम्पराम् ।\nनिरन्तरं विषण्णोऽनुभवन्नत्यन्तशोकवान्",
    "verse_number": "69",
    "char_count": 71
  },
  {
    "chunk_id": "tattvopadesha_070",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अविद्याभूतबन्धस्य निवृत्तौ दुःखदस्य च ।\nस्वरूपानन्दसंप्राप्तौ सत्योपायं न लब्धवान्",
    "verse_number": "70",
    "char_count": 82
  },
  {
    "chunk_id": "tattvopadesha_071",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "यथा गान्धारदेशीयश्चिरं दैवाद्दयालुभिः ।\nकैश्चित्पान्थैः परिप्राप्तैर्मुक्तदृष्ट्यादिबन्धनः",
    "verse_number": "71",
    "char_count": 90
  },
  {
    "chunk_id": "tattvopadesha_072",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सः स्वस्थैरुपदिष्टश्च पण्डितो निश्चितात्मकः ।\nग्रामाद्ग्रामान्तरं गच्छेन्मेधावी मार्गतत्परः",
    "verse_number": "72",
    "char_count": 91
  },
  {
    "chunk_id": "tattvopadesha_073",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "गत्वा गान्धारदेशं स स्वगृहं प्राप्य पूर्ववत् ।\nबान्धवैः सम्परिष्वक्तः सुखी भूत्वा स्थितोऽभवत्",
    "verse_number": "73",
    "char_count": 93
  },
  {
    "chunk_id": "tattvopadesha_074",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "त्वमप्येवमनेकेषु दुःखदायिषु जन्मसु ।\nभ्रान्तो दैवाच्छुभे मार्गे जातश्रद्धः सुकर्मकृत्",
    "verse_number": "74",
    "char_count": 85
  },
  {
    "chunk_id": "tattvopadesha_075",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "वर्णाश्रमाचारपरोऽवाप्तपुण्यमहोदयः ।\nईश्वरानुग्रहाल्लब्धो ब्रह्मविद्गुरुसत्तमः",
    "verse_number": "75",
    "char_count": 77
  },
  {
    "chunk_id": "tattvopadesha_076",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "विधिवत्कृतसंन्यासो विवेकादियुतः सुधीः ।\nप्राप्तो ब्रह्मोपदेशोऽद्य वैराग्याभ्यासतः परम्",
    "verse_number": "76",
    "char_count": 86
  },
  {
    "chunk_id": "tattvopadesha_077",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "पण्डितस्तत्र मेधावी युक्त्या वस्तु विचारयन् ।\nनिदिध्यासनसम्पन्नः प्राप्तो हि त्वं परं पदम्",
    "verse_number": "77",
    "char_count": 90
  },
  {
    "chunk_id": "tattvopadesha_078",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अतो ब्रह्मात्मविज्ञानमुपदिष्टं यथाविधि ।\nमयाचार्येण ते धीर सम्यक्तत्र प्रयत्नवान्",
    "verse_number": "78",
    "char_count": 81
  },
  {
    "chunk_id": "tattvopadesha_079",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "भूत्वा विमुक्तबन्धस्त्वं छिन्नद्वैतात्मसंशयः ।\nनिर्द्वन्द्वो निःस्पृहो भूत्वा विचरस्व यथासुखम्",
    "verse_number": "79",
    "char_count": 94
  },
  {
    "chunk_id": "tattvopadesha_080",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "वस्तुतो निष्प्रपञ्चोऽसि नित्यमुक्तः स्वभावतः ।\nन ते बन्धविमोक्षौ स्तः कल्पितौ तौ यतस्त्वयि",
    "verse_number": "80",
    "char_count": 90
  },
  {
    "chunk_id": "tattvopadesha_081",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "न निरोधो न चोत्पत्तिर्न बद्धो न च साधकः ।\nन मुमुक्षुर्न वै मुक्त इत्येषा परमार्थता",
    "verse_number": "81",
    "char_count": 82
  },
  {
    "chunk_id": "tattvopadesha_082",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "श्रुतिसिद्धान्तसारोऽयं तथैव त्वं स्वया धिया ।\nसंविचार्य निदिध्यास्य निजानन्दात्मकं परम्",
    "verse_number": "82",
    "char_count": 87
  },
  {
    "chunk_id": "tattvopadesha_083",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "साक्षात्कृत्वा परिच्छिन्नाद्वैतब्रह्माक्षरं स्वयम् ।\nजीवन्नेव विनिर्मुक्तो विश्रान्तः शान्तिमाश्रय",
    "verse_number": "83",
    "char_count": 98
  },
  {
    "chunk_id": "tattvopadesha_084",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "विचारणीया वेदान्तो वन्दनीयो गुरुः सदा ।\nगुरूणां वचनं पथ्यं दर्शनं सेवनं नृणाम्",
    "verse_number": "84",
    "char_count": 78
  },
  {
    "chunk_id": "tattvopadesha_085",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "गुरुर्ब्रह्म स्वयं साक्षात्सेव्यो वन्द्यो मुमुक्षुभिः ।\nनोद्वेजनीय एवायं कृतज्ञेन विवेकिना",
    "verse_number": "85",
    "char_count": 90
  },
  {
    "chunk_id": "tattvopadesha_086",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "यावदायुस्त्वया वन्द्यो वेदान्ता गुरुरीश्वरः ।\nमनसा कर्मणा वाचा श्रुतिरेवैष निश्चयः",
    "verse_number": "86",
    "char_count": 82
  },
  {
    "chunk_id": "tattvopadesha_087",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "भावाद्वैतं सदा कुर्यात्क्रियाद्वैतं न कर्हिचित् ।\nअद्वैतं त्रिषु लोकेषु नाद्वैतं गुरुणा सह",
    "verse_number": "87",
    "char_count": 90
  },
  {
    "chunk_id": "tattvopadesha_088",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "इति श्रीमत्परमहंसपरिव्राजकाचार्यस्य\nश्रीगोविन्दभगवत्पूज्यपादशिष्यस्य\nश्रीमच्छङ्करभगवतः कृतौ\nतत्त्वोपदेशः सम्पूर्णः",
    "verse_number": "88",
    "char_count": 114
  },
  {
    "chunk_id": "tattvopadesha_089",
    "text_name": "tattvopadesha",
    "text_title_devanagari": "",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "Pरूओफ़्रेअद् ब्य् षुन्देर् ःआत्तन्गदि\nअन्द् Fएरित् आरव् फ़्ऽरव् अत् होमेंल्\n\n\nPलेअसे सेन्द् चोर्रेच्तिओन्स् तो सन्स्क्रित् अत् चीर्फ़ुल् दोत् च् ओम्\nळस्त् उप्दतेद् \\तोदय्\nह्त्त्प्स्://सन्स्क्रित्दोचुमेन्त्स्।ओर्ग्",
    "verse_number": "89",
    "char_count": 210
  }
]