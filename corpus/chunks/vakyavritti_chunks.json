[
  {
    "chunk_id": "vakyavritti_001",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सर्गस्थितिप्रलयहेतुमचिन्त्यशक्तिं विश्वेश्वरं विदितविश्वमनन्तमूर्तिम् ।\nनिर्मुक्तबन्धनमपारसुखाम्बुराशिं श्रीवल्लभं विमलबोधघनं नमामि",
    "verse_number": "1",
    "char_count": 131
  },
  {
    "chunk_id": "vakyavritti_002",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "यस्य प्रसादादहमेव विष्णुर्मय्येव सर्वं परिकल्पितं च ।\nइत्थं विजानामि सदात्मरूपं तस्यांघ्रिपद्मं प्रणतोऽस्मि नित्यम्",
    "verse_number": "2",
    "char_count": 115
  },
  {
    "chunk_id": "vakyavritti_003",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तापत्रयार्कसंतप्तः कश्चिदुद्विग्नमानसः ।\nशमादिसाधनैर्युक्तः सद्गुरुं परिपृच्छति",
    "verse_number": "3",
    "char_count": 79
  },
  {
    "chunk_id": "vakyavritti_004",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अनायासेन येनास्मान्मुच्च्येयं भवबन्धनात् ।\nतन्मे संक्षिप्य भगवन्केवलं कृपया वद",
    "verse_number": "4",
    "char_count": 78
  },
  {
    "chunk_id": "vakyavritti_005",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "गुरुरुवाच ।\nसाध्वीते वचनव्यक्तिः प्रतिभाति वदामि ते ।\nइदं तदिति विस्पष्टं सावधानमनाः शृणु",
    "verse_number": "5",
    "char_count": 89
  },
  {
    "chunk_id": "vakyavritti_006",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तत्त्वमस्यादिवाक्योत्थं यज्जीवपरमात्मनोः ।\nतादात्म्यविषयं ज्ञानं तदिदं मुक्तिसाधनम्",
    "verse_number": "6",
    "char_count": 83
  },
  {
    "chunk_id": "vakyavritti_007",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "शिष्य उवाच ।\nको जीवः कः परश्चात्मा तादात्म्यं वा कथं तयोः ।\nतत्त्वमस्यादिवाक्यं वा कथं तत्प्रतिपादयेत्",
    "verse_number": "7",
    "char_count": 102
  },
  {
    "chunk_id": "vakyavritti_008",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "गुरुरुवाच ।\nअत्र ब्रूमः समाधानं कोऽन्यो जीवस्त्वमेव हि ।\nयस्त्वं पृच्छसि मां कोऽहं ब्रह्मैवासि न संशयः",
    "verse_number": "8",
    "char_count": 102
  },
  {
    "chunk_id": "vakyavritti_009",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "शिष्य उवाच ।\nपदार्थमेव जानामि नाद्यापि भगवन्स्फुटम् ।\nअहं ब्रह्मेति वाक्यार्थं प्रतिपद्ये कथं वद",
    "verse_number": "9",
    "char_count": 96
  },
  {
    "chunk_id": "vakyavritti_010",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "गुरुरुवाच ।\nसत्यमाह भवानत्र विगानं नैव विद्यते ।  विज्ञानं\nहेतुः पदार्थबोधो हि वाक्यार्थावगतेरिह",
    "verse_number": "10",
    "char_count": 96
  },
  {
    "chunk_id": "vakyavritti_011",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अन्तःकरणतद्वृत्तिसाक्षिचैतन्यविग्रहः ।\nआनन्दरूपः सत्यः सन्किं नात्मानं प्रपद्यसे",
    "verse_number": "11",
    "char_count": 80
  },
  {
    "chunk_id": "vakyavritti_012",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सत्यानन्दस्वरूपं धीसाक्षिणं बोधविग्रहम् ।\nचिन्तयात्मतया नित्यं त्यक्त्वा देहादिगां धियम्",
    "verse_number": "12",
    "char_count": 88
  },
  {
    "chunk_id": "vakyavritti_013",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "रूपादिमान्यतः पिण्डस्ततो नात्मा घटादिवत् ।\nवियदादिमहाभूतविकारत्वाच्च कुम्भवत्",
    "verse_number": "13",
    "char_count": 77
  },
  {
    "chunk_id": "vakyavritti_014",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अनात्मा यदि पिण्डोऽयमुक्तहेतुबलान्मतः ।\nकरामलकवत्साक्षादात्मानं प्रतिपादय",
    "verse_number": "14",
    "char_count": 73
  },
  {
    "chunk_id": "vakyavritti_015",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "घटद्रष्टा घटाद्भिन्नः सर्वथा न घटो यथा ।\nदेहद्रष्टा तथा देहो नाहमित्यवधारय",
    "verse_number": "15",
    "char_count": 74
  },
  {
    "chunk_id": "vakyavritti_016",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "एवमिन्द्रियदृङ्नाहमिन्द्रियाणीति निश्चिनु ।\nमनोबुद्धिस्तथा प्राणो नाहमित्यवधारय",
    "verse_number": "16",
    "char_count": 79
  },
  {
    "chunk_id": "vakyavritti_017",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "संघातोऽपि तथा नाहमिति दृश्यविलक्षणम् ।\nद्रष्टारमनुमानेन निपुणं सम्प्रधारय",
    "verse_number": "17",
    "char_count": 73
  },
  {
    "chunk_id": "vakyavritti_018",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "देहेन्द्रियादयो भावा हानादिव्यापृतिक्षमाः ।\nयस्य सन्निधिमात्रेण सोऽहमित्यवधारय",
    "verse_number": "18",
    "char_count": 78
  },
  {
    "chunk_id": "vakyavritti_019",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अनापन्नविकारः सन्नयस्कान्तवदेव यः ।\nबुद्ध्यादींश्चालयेत्प्रत्यक्।ह् सोऽहमित्यवधारय",
    "verse_number": "19",
    "char_count": 82
  },
  {
    "chunk_id": "vakyavritti_020",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अजडात्मवदाभान्ति यत्सान्निध्याज्जडा अपि ।\nदेहेन्द्रियमनःप्राणाः सोऽहमित्यवधारय",
    "verse_number": "20",
    "char_count": 78
  },
  {
    "chunk_id": "vakyavritti_021",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अगमन्मे मनोऽन्यत्र साम्प्रतं च स्थिरीकृतम् ।\nएवं यो वेत्ति धीवृत्तिं सोऽहमित्यवधारय",
    "verse_number": "21",
    "char_count": 83
  },
  {
    "chunk_id": "vakyavritti_022",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "स्वप्नजागरिते सुप्तिं भावाभावौ धियां तथा ।\nयो वेत्त्यविक्रियः साक्षात्सोऽहमित्यवधारय",
    "verse_number": "22",
    "char_count": 84
  },
  {
    "chunk_id": "vakyavritti_023",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "घटावभासको दीपो घटादन्यो यथेष्यते ।\nदेहावभासको देही तथाहं बोधविग्रहः",
    "verse_number": "23",
    "char_count": 67
  },
  {
    "chunk_id": "vakyavritti_024",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "पुत्रवित्तादयो भावा यस्य शेषतया प्रियाः ।\nद्रष्टा सर्वप्रियतमः सोऽहमित्यवधारय",
    "verse_number": "24",
    "char_count": 77
  },
  {
    "chunk_id": "vakyavritti_025",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "परप्रेमास्पदतया मा न भूवमहं सदा ।\nभूयासमिति यो द्रष्टा सोऽहमित्यवधारय",
    "verse_number": "25",
    "char_count": 69
  },
  {
    "chunk_id": "vakyavritti_026",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "यः साक्षिलक्षणो बोधस्त्वंपदार्थः स उच्यते ।\nसाक्षित्वमपि बोद्धृत्वमविकारितयात्मनः",
    "verse_number": "26",
    "char_count": 81
  },
  {
    "chunk_id": "vakyavritti_027",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "देहेन्द्रियमनःप्राणाहङ्कृतिभ्यो विलक्षणः ।\nप्रोज्झिताशेशषड्भावविकारस्त्वंपदाभिधः",
    "verse_number": "27",
    "char_count": 80
  },
  {
    "chunk_id": "vakyavritti_028",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "त्वमर्थमेवं निश्चित्य तदर्थं चिन्तयेत्पुनः ।\nअतद्व्यावृत्तिरूपेण साक्षाद्विधिमुखेन च",
    "verse_number": "28",
    "char_count": 84
  },
  {
    "chunk_id": "vakyavritti_029",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "निरस्ताशेषसंसारदोषोऽस्थुलादिलक्षणः ।\nअदृश्यत्वादिगुणकः पराकृततमोमलः",
    "verse_number": "29",
    "char_count": 67
  },
  {
    "chunk_id": "vakyavritti_030",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "निरस्तातिशयानन्दः सत्यप्रज्ञानविग्रहः ।\nसत्तास्वलक्षणः पूर्ण परमात्मेति गीयते",
    "verse_number": "30",
    "char_count": 77
  },
  {
    "chunk_id": "vakyavritti_031",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "सर्वज्ञत्वं परेशत्वं तथा सम्पूर्णशक्तिता ।\nवेदैः समर्थ्यते यस्य तद्ब्रह्मेत्यवधारय",
    "verse_number": "31",
    "char_count": 82
  },
  {
    "chunk_id": "vakyavritti_032",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "यज्ज्ञानात्सर्वविज्ञानं श्रुतिषु प्रतिपादितम् ।\nमृदाद्यनेकदृष्टान्तैस्तद्ब्रह्मेत्यवधारय",
    "verse_number": "32",
    "char_count": 88
  },
  {
    "chunk_id": "vakyavritti_033",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "यदानन्त्यं प्रतिज्ञाय श्रुतिस्तत्सिद्धये जगौ ।\nतत्कार्यत्वं प्रपञ्चस्य तद्ब्रह्मेत्यवधारय",
    "verse_number": "33",
    "char_count": 89
  },
  {
    "chunk_id": "vakyavritti_034",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "विजिज्ञास्यतया यच्च वेदान्तेषु मुमुक्षुभिः ।\nसमर्थ्यतेऽतियत्नेन तद्ब्रह्मेत्यवधारय",
    "verse_number": "34",
    "char_count": 82
  },
  {
    "chunk_id": "vakyavritti_035",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "जीवात्मना प्रवेशश्च नियन्तृत्वं च तान्।ह् प्रति ।\nश्रूयते यस्य वेदेषु तद्ब्रह्मेत्यवधारय",
    "verse_number": "35",
    "char_count": 88
  },
  {
    "chunk_id": "vakyavritti_036",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "कर्मणां फलदातृत्वं यस्यैव श्रूयते श्रुतौ ।\nजीवानां हेतुकर्तृत्वं तद्ब्रह्मेत्यवधारय",
    "verse_number": "36",
    "char_count": 83
  },
  {
    "chunk_id": "vakyavritti_037",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तत्त्वंपदार्थौ निर्णीतौ वाक्यार्थश्चिन्त्यतेऽधुना ।\nतादात्म्यमत्र वाक्यार्थस्तयोरेव पदार्थयोः",
    "verse_number": "37",
    "char_count": 93
  },
  {
    "chunk_id": "vakyavritti_038",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "संसर्गो वा विशिष्टो वा वाक्यार्थो नात्र सम्मतः ।\nअखण्डैकरसत्वेन वाक्यार्थो विदुषां मतः",
    "verse_number": "38",
    "char_count": 86
  },
  {
    "chunk_id": "vakyavritti_039",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "प्रत्यग्बोधो य आभाति सोऽद्वयानन्दलक्षणः ।\nअद्वयानन्दरूपश्च प्रत्यग्बोधैकलक्षणः",
    "verse_number": "39",
    "char_count": 78
  },
  {
    "chunk_id": "vakyavritti_040",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "इत्थमन्योन्यतादात्म्यप्रतिपत्तिर्यदा भवेत् ।\nअब्रह्मत्वं त्वमर्थस्य व्यावर्तेत तदैव हि",
    "verse_number": "40",
    "char_count": 86
  },
  {
    "chunk_id": "vakyavritti_041",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तदर्थस्य पारोक्ष्यं यद्येवं किं ततः श्रुणु ।\nपूर्णानन्दैकरूपेण प्रत्यग्बोधोवतिष्ठते",
    "verse_number": "41",
    "char_count": 83
  },
  {
    "chunk_id": "vakyavritti_042",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तत्त्वमस्यादिवाक्यं च तादात्म्यप्रतिपादने ।\nलक्ष्यौ तत्त्वंपदार्थौ द्वावुपादाय प्रवर्तते",
    "verse_number": "42",
    "char_count": 88
  },
  {
    "chunk_id": "vakyavritti_043",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "हित्वा द्वौ शबलौ वाच्यौ वाक्यं वाक्यार्थबोधने ।\nयथा प्रवर्ततेऽस्माभिस्तथा व्याख्यातमादरात्",
    "verse_number": "43",
    "char_count": 90
  },
  {
    "chunk_id": "vakyavritti_044",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "आलम्बनतयाभाति योऽस्मत्प्रत्ययशब्दयोः ।\nअन्तःकरणसंभिन्नबोधः स त्वंपदाभिधः",
    "verse_number": "44",
    "char_count": 72
  },
  {
    "chunk_id": "vakyavritti_045",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "मायोपाधिर्जगद्योनिः सर्वज्ञत्वादिलक्षणः ।\nपरोक्ष्यशबलः सत्याद्यात्मकस्तत्पदाभिधः",
    "verse_number": "45",
    "char_count": 80
  },
  {
    "chunk_id": "vakyavritti_046",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "प्रत्यक्परोक्षतैकस्य सद्वितीयत्वपूर्णता ।\nविरुध्यते यतस्तस्माल्लक्षणा सम्प्रवर्तते",
    "verse_number": "46",
    "char_count": 82
  },
  {
    "chunk_id": "vakyavritti_047",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "मानान्तरविरोधे तु मुख्यार्थस्य परिग्रहे ।\nमुख्यार्थेनाविनाभूते प्रतीतिर्लक्षणोच्यते",
    "verse_number": "47",
    "char_count": 83
  },
  {
    "chunk_id": "vakyavritti_048",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "तत्त्वमस्यादिवाक्येषु लक्षणा भागलक्षणा ।\nसोऽयमित्यादिवाक्यस्थपदयोरिव नापरा",
    "verse_number": "48",
    "char_count": 74
  },
  {
    "chunk_id": "vakyavritti_049",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "अहं ब्रह्मेतिवाक्यार्थबोधो यावद्दृढीभवेत् ।\nशमादिसहितस्तावदभ्यसेच्छ्रवणादिकम्",
    "verse_number": "49",
    "char_count": 77
  },
  {
    "chunk_id": "vakyavritti_050",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "श्रुत्याचार्यप्रसादेन दृढो बोधो यदा भवेत् ।\nनिरस्ताशेषसंसारनिदानः पुरुषस्तदा",
    "verse_number": "50",
    "char_count": 76
  },
  {
    "chunk_id": "vakyavritti_051",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "विशीर्णकार्यकरणो भूतसूक्ष्मैरनावृतः ।\nविमुक्तकर्मनिगडः सद्य एव विमुच्यते",
    "verse_number": "51",
    "char_count": 72
  },
  {
    "chunk_id": "vakyavritti_052",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "प्रारब्धकर्मवेगेन जीवन्मुक्तो यदा भवेत् ।\nकिञ्चित्कालमनारब्धकर्मबन्धस्य संक्षये",
    "verse_number": "52",
    "char_count": 79
  },
  {
    "chunk_id": "vakyavritti_053",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "निरस्तातिशयानन्दं वैष्णवं परमं पदम् ।\nपुनरावृत्तिरहितं कैवल्यं प्रतिपद्यते",
    "verse_number": "53",
    "char_count": 74
  },
  {
    "chunk_id": "vakyavritti_054",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "इति परमहंसपरिव्राजकाचार्यश्रीमच्छङ्कराचार्यविरचिता\nवाक्यवृत्तिः समाप्त",
    "verse_number": "54",
    "char_count": 70
  },
  {
    "chunk_id": "vakyavritti_055",
    "text_name": "vakyavritti",
    "text_title_devanagari": "वाक्यवृत्तिः",
    "category": "prakarana",
    "authenticity": "attributed",
    "source": "sanskritdocuments.org",
    "language": "sa",
    "content": "Eन्चोदेद् अन्द् प्रूफ़्रेअद् ब्य् षुन्देर् ःअत्तन्गदि\nPरूफ़्रेअद् ब्य् Bर्। Pरनिपत छैतन्य, डविद् ळ्य्त्त्ले\n\n\nPलेअसे सेन्द् चोर्रेच्तिओन्स् तो सन्स्क्रित्@चीर्फ़ुल्ॅओम्\nळस्त् उप्दतेद् \\तोदय्\nह्त्त्प्स्://सन्स्क्रित्दोचुमेन्त्स्।ओर्ग्",
    "verse_number": "55",
    "char_count": 230
  }
]